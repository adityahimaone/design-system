---
import Layout from '@/layouts/Layout.astro'
import '@/features/halation/halation-tokens.css'
---

<Layout
  title="404 — Halation"
  description="This page is outside the pane. The shelf is still there."
  noindex
>
  <main class="nf">
    <div class="nf__in">
      <a class="nf__mark" href="/" aria-label="Halation — home">
        <img src="/brand/halation/mark.svg" width="52" height="52" alt="" />
      </a>

      <p class="nf__code">Error 404</p>
      <h1 class="nf__title">This page is outside the pane.</h1>
      <p class="nf__lead">
        The light stops at the edge here. Everything that does exist is still on the shelf — fifteen
        systems, each with its own primitives and its own admitted failure.
      </p>

      <a class="nf__back" href="/">
        Back to the shelf
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 11 11 3M11 3H5M11 3v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
    <span class="nf__spill" aria-hidden="true"></span>
  </main>
</Layout>

<style>
  .nf {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: var(--ha-s7) var(--ha-s6);
    background: var(--ha-surface-page);
    color: var(--ha-text);
    font-family: var(--ha-font-reading);
    overflow: clip;
  }

  .nf__in {
    width: 100%;
    max-width: 620px;
    margin: 0 auto;
    display: grid;
    gap: var(--ha-s4);
    justify-items: start;
  }

  .nf__mark {
    display: block;
    margin-bottom: var(--ha-s5);
  }
  .nf__mark img {
    display: block;
  }

  .nf__code {
    margin: 0;
    font-family: var(--ha-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ha-text-mute);
  }

  .nf__title {
    margin: 0;
    font-family: var(--ha-font-display);
    font-weight: 600;
    font-size: clamp(34px, 5.2vw, 58px);
    line-height: 1;
    letter-spacing: -0.038em;
    max-width: 16ch;
    text-wrap: balance;
  }

  .nf__lead {
    margin: var(--ha-s2) 0 0;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.6;
    color: color-mix(in oklab, var(--ha-text) 72%, transparent);
  }

  .nf__back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: var(--ha-s4);
    padding: 13px 22px;
    border-radius: 999px;
    background: var(--ha-accent);
    color: var(--ha-accent-ink);
    font-family: var(--ha-font-reading);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
  }
  .nf__back:hover {
    background: color-mix(in oklab, var(--ha-accent) 88%, var(--ha-ink));
  }
  .nf__back:active {
    transform: translateY(1px);
  }
  .nf__back:focus-visible {
    outline: 2px solid var(--ha-focus);
    outline-offset: 3px;
  }

  /* the one reed of light — a beam, not a border, so it fades before it becomes page furniture */
  .nf__spill {
    position: absolute;
    top: 0;
    right: clamp(18px, 7vw, 96px);
    width: 5px;
    height: 62%;
    background: linear-gradient(
      to bottom,
      var(--ha-accent) 0%,
      var(--ha-accent) 72%,
      color-mix(in oklab, var(--ha-accent) 0%, transparent) 100%
    );
    opacity: 0.85;
    pointer-events: none;
  }

  @media (max-width: 620px) {
    .nf {
      padding: var(--ha-s6) var(--ha-s5);
    }
    .nf__spill {
      right: 14px;
      width: 4px;
    }
  }
</style>
