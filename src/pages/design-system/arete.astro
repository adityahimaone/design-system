---
import Layout from '@/layouts/Layout.astro'
import tokens from '@/features/arete/tokens.json'
import '@/features/arete/arete-tokens.css'
import '@/features/arete/arete-page.css'

const B = '/brand/arete'
const title = 'Arête — Case 18 | Paper-cut alpine · every layer is a cut'
const description =
  'Arête: an alpine cartography atelier built from ivory cartridge stock and one ultramarine impression. Type set on the range itself, five paper surfaces, six companion cut marks, and a measured contrast ledger that prints the three pairs it fails.'

const NAV = ['Idea', 'Mark', 'Colour', 'Surfaces', 'Type', 'Kit', 'Tokens']

const CAST_ITEMS = [
  { id: 'sommet', name: 'Sommet', role: 'The high point of a traverse' },
  { id: 'boussole', name: 'Boussole', role: 'Bearing, declination, north' },
  { id: 'courbe', name: 'Courbe', role: 'A line of equal altitude' },
  { id: 'meleze', name: 'Mélèze', role: 'The tree line and its wind' },
  { id: 'refuge', name: 'Refuge', role: 'Hut, gable, one door' },
  { id: 'cairn', name: 'Cairn', role: 'A mark left for the next party' },
]

const PREMISE = [
  {
    k: 'Belief',
    v: 'A map is a physical object before it is an interface. It should read as cut, registered and stacked — looked at under raking light, not rendered on a screen.',
  },
  {
    k: 'Enemy',
    v: 'Gradient-mesh “outdoor brand” chrome, glass route dashboards, neon contour lines, and soft 40px shadows that turn paper back into plastic.',
  },
  {
    k: 'Material',
    v: 'Ivory cartridge stock, tracing vellum, one ultramarine impression, one oxide survey blaze, and a graphite pencil for the annotations.',
  },
  {
    k: 'Reject it when',
    v: 'The brand needs density above 4 rows per screen, or must sit on a moving image where a paper ground cannot hold its edge.',
  },
]

const DECISIONS = [
  {
    title: 'Two papers, five surfaces',
    decision:
      'Ivory stock is the canvas, ultramarine is the ink. Depth comes from five named surfaces — cut sheet, lifted layer, vellum overlay, deckle edge, register ghost — and each has exactly one job.',
    because:
      'A two-paper system makes every depth decision explicit instead of letting each component invent its own shadow recipe.',
    notWhen: 'Print-only exports where a vellum overlay cannot be reproduced on press.',
    breaksNext: 'Adding a sixth decorative surface without assigning it a job.',
  },
  {
    title: 'The 5-unit seam is the only ornament',
    decision:
      'Every gap quotes the 5u knife: the mark aperture, card seams, table rules, and the baseline offset of the wordmark.',
    because:
      'One measure repeated is what makes a paper system read as one hand rather than a component library in a paper costume.',
    notWhen: 'Dense permit tables where rows need more air than one knife width.',
    breaksNext: 'Using 8px gaps in one component and 4px in another and calling both “the seam”.',
  },
  {
    title: 'Hard shadows, zero blur inside a layer',
    decision:
      'Sheets lift with a 4px 4px 0 shadow at 12% ink. Only the vellum overlay may blur, because it is the one sheet that sits above artwork.',
    because:
      'Blur reads as light; paper has an edge. Keeping blur out of the layer system is what keeps the surfaces looking cut instead of rendered.',
    notWhen: 'The footer plate, which sits over a photograph and needs 18px of fibre blur to hold type.',
    breaksNext: 'A component that adds a 20px soft shadow to look “modern”.',
  },
  {
    title: 'Oxide is a blaze, never a label',
    decision:
      'Oxide (#C4462B) measures 4.2:1 on stock, so it is restricted to rules ≥3px, survey marks and graphic fills. Text on oxide is indigo at 8.1:1.',
    because:
      'Darkening the blaze until it passed 4.5:1 turns a warm survey signal into brick and loses the only warm note in a cold range.',
    notWhen: 'A chip where oxide is the background and indigo carries the words.',
    breaksNext: 'Using oxide for link text, a caption, or a 12px status label.',
  },
]

const SURFACES = [
  {
    id: 'cut',
    title: 'Cut sheet',
    verdict: 'Shipped — every plate',
    demo: 'cut',
    note: 'A chalk sheet on ivory stock with a 1px deckle hairline and a 4px 4px 0 offset at 12% ink. The default depth: the page is a stack and this is the top sheet.',
  },
  {
    id: 'lifted',
    title: 'Lifted layer',
    verdict: 'Shipped — decision cards',
    demo: 'lifted',
    note: 'A vellum panel raised 6px above the sheet with an exposed seam on two sides only. Reads as a sheet placed down, never as a floating card.',
  },
  {
    id: 'vellum',
    title: 'Vellum overlay',
    verdict: 'Shipped — footer plate',
    demo: 'vellum',
    note: '88% paper over artwork with 18px of real backdrop blur. The only blurred layer in the system, because it is the only one that sits above a photograph.',
  },
  {
    id: 'deckle',
    title: 'Deckle edge',
    verdict: 'Shipped — section rules',
    demo: 'deckle',
    note: 'A 1px rule that steps 1px at four irregular intervals, quoting a torn deckle without drawing a torn edge. Section dividers and table rules.',
  },
  {
    id: 'register',
    title: 'Register ghost',
    verdict: 'Shipped — display type',
    demo: 'register',
    note: 'The display line printed twice, offset 1px in ultramarine at 22%. One colour, two impressions — the cheapest way to say “printed, not lit”.',
  },
  {
    id: 'stipple',
    title: 'Stipple field',
    verdict: 'Rejected',
    demo: 'stipple',
    rejected: true,
    note: 'A 2% dot field standing in for paper grain. Rejected: at 1440 it disappears, at 390 it turns into noise, and the stock already carries the grain.',
  },
]

const TYPE_SCALE = tokens.type.scale

const ROUTES = [
  {
    id: 'midi',
    name: 'Arête du Midi',
    meta: 'Summit traverse · 3 hut nights · SE ridge',
    grade: 'UIAA III',
    distance: '11.4 km',
    ascent: '1,486 m',
    high: '3,842 m',
    fee: 240,
  },
  {
    id: 'cime',
    name: 'Col de la Cime',
    meta: 'Hut-to-hut · 1 hut night · W shoulder',
    grade: 'UIAA II',
    distance: '8.2 km',
    ascent: '940 m',
    high: '3,104 m',
    fee: 180,
  },
  {
    id: 'noir',
    name: 'Glacier Noir',
    meta: 'Glacier crossing · 2 hut nights · N face',
    grade: 'UIAA IV',
    distance: '14.6 km',
    ascent: '1,820 m',
    high: '3,566 m',
    fee: 320,
  },
]

const cssPrimitives = `/* 1 · primitive — the material, named once */
:root {
${tokens.primitives.map((p) => `  --ar-${p.name}: ${p.value}; /* ${p.oklch} */`).join('\n')}
}`

const cssDay = `/* 2 · semantic · ivory stock (default scope) */
:root {
  --ar-surface-page: var(--ar-paper);
  --ar-surface-plate: var(--ar-chalk);
  --ar-surface-sheet: var(--ar-vellum);
  --ar-text-primary: var(--ar-indigo);
  --ar-text-secondary: var(--ar-graphite);
  --ar-line-strong: color-mix(in srgb, var(--ar-indigo) 34%, transparent);
  --ar-line-subtle: color-mix(in srgb, var(--ar-indigo) 14%, transparent);
  --ar-accent: var(--ar-ultramarine);
  --ar-blaze: var(--ar-oxide);
}`

const cssDusk = `/* 2 · semantic · ultramarine dusk — a scope, never a second palette */
[data-ar='dusk'] {
  --ar-surface-page: #0C0E22;
  --ar-surface-plate: #141733;
  --ar-surface-sheet: #1D2144;
  --ar-text-primary: #F3EEE3;
  --ar-text-secondary: #B9BFDD;
  --ar-line-strong: rgba(243, 238, 227, 0.34);
  --ar-line-subtle: rgba(243, 238, 227, 0.14);
  --ar-accent: #8C9CE0;
  --ar-blaze: #E0654A;
}`

const cssComponent = `/* 3 · component — a lifted sheet, and the one vellum plate */
.ar-card {
  background: var(--ar-surface-plate);
  border: 1px solid var(--ar-line-subtle);
  box-shadow: 4px 4px 0 color-mix(in srgb, var(--ar-indigo) 12%, transparent);
}
.ar-plate {
  background: color-mix(in srgb, var(--ar-paper) 88%, transparent);
  backdrop-filter: blur(18px) saturate(120%);
  border: 1px solid var(--ar-line-strong);
}`

const cssPhysics = `/* 4 · physics — the knife */
:root {
  --ar-radius: 0px;
  --ar-rule: 1px;
  --ar-seam: 5px;
  --ar-lift: 4px;
  --ar-dur: 140ms;
  --ar-ease: cubic-bezier(0.2, 0.7, 0.3, 1);
  --ar-shadow-lift: 4px 4px 0 color-mix(in srgb, var(--ar-indigo) 12%, transparent);
}`

const SHEETS = [
  { n: '1', title: 'Primitives', lang: 'css', code: cssPrimitives },
  { n: '2', title: 'Stock scope', lang: 'css', code: cssDay },
  { n: '3', title: 'Dusk scope', lang: 'css', code: cssDusk },
  { n: '4', title: 'Component tokens', lang: 'css', code: cssComponent },
  { n: '5', title: 'Physics', lang: 'css', code: cssPhysics },
]

const GAPS = [
  {
    t: 'Verified',
    d: 'All fourteen contrast pairs are computed from hex at build time and printed above, including the three that fail. The 16px compact mark is a separate drawing, tested at 16 and 24.',
  },
  {
    t: 'Not verified in a browser',
    d: 'Browser QA was skipped by request. Contrast is arithmetic, not a rendering test — the dusk scope has not been eyeballed against the panorama at 390px.',
  },
  {
    t: 'Papered over',
    d: 'Real uncoated-stock grain is a photograph of paper. The system simulates it with a 2% stipple on display plates only; a real press proof would replace it.',
  },
  {
    t: 'Density ceiling',
    d: 'Paper surfaces stop working above ~4 rows per screen. The kit caps route tables at three rows and pushes the rest into a permit sheet, by construction.',
  },
]

const facts = {
  primitives: tokens.primitives.length,
  pairs: tokens.contrast.length,
  fails: tokens.contrast.filter((c) => !c.pass).length,
  passes: tokens.contrast.filter((c) => c.pass).length,
}
---

<Layout title={title} description={description} canonical="/design-system/arete" image={`${B}/arete-brandkit.png`}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Instrument+Sans:ital,wght@0,400..700;1,400..600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <div class="ar-root" id="top" data-ar="day">
    <script is:inline>
      try {
        if (localStorage.getItem('ar-scope') === 'dusk') {
          document.querySelector('.ar-root')?.setAttribute('data-ar', 'dusk')
        }
      } catch (e) {}
    </script>

    <a class="ar-skip" href="#idea">Skip to the idea</a>

    <header class="ar-bar">
      <div class="ar-bar__in">
        <a class="ar-bar__brand" href="#top" aria-label="Arête, back to top">
          <img src={`${B}/mark.svg`} width="24" height="24" alt="" />
          <span class="ar-bar__name">Arête</span>
          <span class="ar-bar__case">Case 18</span>
        </a>

        <nav class="ar-nav" aria-label="Arête sections">
          {NAV.map((label, i) => (
            <a href={`#${['idea', 'mark', 'colour', 'surfaces', 'type', 'kit', 'tokens'][i]}`}>{label}</a>
          ))}
        </nav>

        <button id="arScope" class="ar-scope" type="button" aria-pressed="false">
          <i aria-hidden="true"></i>
          <span id="arScopeLabel">Ivory stock</span>
        </button>
      </div>
    </header>

    <main>
      {/* hero: E · relation on · scrim 178deg paper → transparent · type on the
          range itself. No panel, no card, no readout box. The photograph is the
          ground and the paper wash only covers the sky the type sits in. */}
      <section class="ar-hero" id="hero" aria-labelledby="ar-hero-h">
        <img
          class="ar-hero__img"
          src={`${B}/arete-panorama.webp`}
          alt="The Arête traverse in panorama: a snow ridge stepping down from a bright white sky into a dark valley, with one cobalt band of shadow across the middle."
          width="1672"
          height="941"
          fetchpriority="high"
        />
        <div class="ar-hero__wash" aria-hidden="true"></div>

        <div class="ar-hero__in">
          <p class="ar-hero__eyebrow">
            <span>46°12′N · 07°04′E · 3,842 m</span>
            <span>Paper-cut alpine · V2.0</span>
          </p>

          <h1 class="ar-hero__h1" id="ar-hero-h">Every layer<br />is a <em>cut.</em></h1>

          <p class="ar-hero__lede">
            Guided ridge traverses and hand-cut topographic editions, printed on two papers: ivory
            cartridge stock and one ultramarine impression. The system below is what the sheet does
            when you lay another one on top of it.
          </p>

          <div class="ar-hero__acts">
            <a class="ar-btn ar-btn--solid" href="#kit">Plan a traverse</a>
            <a class="ar-btn ar-btn--ghost" href="#tokens">Copy the OKLCH tokens</a>
            <a class="ar-btn ar-btn--ghost" href={`${B}/arete-figma.html`}>Figma HTML sheet ↗</a>
          </div>

          <dl class="ar-hero__stats">
            <div><dt>Primitives</dt><dd>{facts.primitives}</dd></div>
            <div><dt>Contrast pairs</dt><dd>{facts.pairs}</dd></div>
            <div><dt>Printed fails</dt><dd>{String(facts.fails).padStart(2, '0')}</dd></div>
            <div><dt>Seam</dt><dd>5<span>u</span></dd></div>
          </dl>
        </div>

        <p class="ar-hero__cap">
          <span>Plate 01 · the traverse</span>
          <span>Summit ridge, looking south-east · printed 1:25 000</span>
        </p>
      </section>

      {/* 01 · IDEA ========================================================= */}
      <section class="ar-sec" id="idea">
        <div class="ar-sec__wrap">
          <div class="ar-rail">
            <span class="ar-rail__n">01</span>
            <span class="ar-rail__l">Idea</span>
          </div>
          <div class="ar-body">
            <h2 class="ar-h2">Paper separates with an edge, not a glow.</h2>
            <p class="ar-big">
              Four beliefs about maps as physical objects, then four decisions with explicit
              failure boundaries so the next agent cannot quietly turn stacked sheets into glass
              cards.
            </p>

            <div class="ar-two">
              {PREMISE.map((p) => (
                <div class="ar-cell">
                  <h3>{p.k}</h3>
                  <p>{p.v}</p>
                </div>
              ))}
            </div>

            <div class="ar-decs">
              {DECISIONS.map((d) => (
                <article class="ar-dec">
                  <h3>{d.title}</h3>
                  <p>{d.decision}</p>
                  <dl>
                    <div><dt>Because</dt><dd>{d.because}</dd></div>
                    <div><dt>Not when</dt><dd>{d.notWhen}</dd></div>
                    <div><dt>Breaks next</dt><dd>{d.breaksNext}</dd></div>
                  </dl>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* 02 · MARK ========================================================= */}
      <section class="ar-sec" id="mark">
        <div class="ar-sec__wrap">
          <div class="ar-rail">
            <span class="ar-rail__n">02</span>
            <span class="ar-rail__l">Mark</span>
          </div>
          <div class="ar-body">
            <h2 class="ar-h2">One ridge, drawn twice.</h2>
            <p class="ar-big">
              Two stacked torn bands inside a 64-unit square: the upper band is the ridge you see,
              the lower is the mass under it, and the gap between them is the 5-unit knife. Nothing
              else is drawn — no summit star, no compass point, no gradient.
            </p>

            <div class="ar-marks">
              <figure class="ar-mark ar-mark--sheet">
                <img src={`${B}/mark.svg`} alt="The primary Arête mark: two stacked torn bands." width="64" height="64" />
                <figcaption><b>Primary</b><span>One colour, any ground</span></figcaption>
              </figure>
              <figure class="ar-mark ar-mark--ink">
                <img src={`${B}/mark-reverse.svg`} alt="The reverse mark on the ultramarine ground." width="64" height="64" />
                <figcaption><b>Reverse</b><span>On ultramarine or ink</span></figcaption>
              </figure>
              <figure class="ar-mark ar-mark--sheet">
                <img src={`${B}/mark-compact.svg`} alt="The 16px compact drawing: fatter bands, one straight cut." width="64" height="64" />
                <figcaption><b>Compact</b><span>A separate 16px drawing</span></figcaption>
              </figure>
              <figure class="ar-mark ar-mark--sheet">
                <img src={`${B}/glyph.svg`} alt="The glyph: the mark without its aperture." width="64" height="64" />
                <figcaption><b>Glyph</b><span>Favicon and 16px chrome</span></figcaption>
              </figure>
            </div>

            <div class="ar-lock">
              <div class="ar-lock__row">
                <img src={`${B}/lockup.svg`} alt="The horizontal lockup: mark beside the ARÊTE wordmark." height="26" />
                <span>Horizontal · mark 26 units, wordmark baseline on the lower band</span>
              </div>
              <div class="ar-lock__row ar-lock__row--ink">
                <img src={`${B}/lockup-reverse.svg`} alt="The reverse lockup on ink." height="26" />
                <span>Reverse · for ultramarine plates and the dusk scope</span>
              </div>
              <div class="ar-lock__row">
                <img src={`${B}/lockup-stacked.svg`} alt="The stacked lockup: wordmark above the mark." height="52" />
                <span>Stacked · covers, stamps and the 1:25 000 sheet corner</span>
              </div>
            </div>

            <div class="ar-scale">
              {[
                { s: 96, f: 'mark.svg', l: '96' },
                { s: 48, f: 'mark.svg', l: '48' },
                { s: 32, f: 'mark.svg', l: '32' },
                { s: 24, f: 'mark-compact.svg', l: '24 compact' },
                { s: 16, f: 'mark-compact.svg', l: '16 compact' },
                { s: 16, f: 'glyph.svg', l: '16 glyph' },
              ].map((m) => (
                <figure>
                  <img src={`${B}/${m.f}`} alt="" width={m.s} height={m.s} style={`width:${m.s}px;height:${m.s}px`} />
                  <figcaption>{m.l}</figcaption>
                </figure>
              ))}
            </div>

            <div class="ar-rules">
              <div>
                <h4>Clear space</h4>
                <p>One 5u knife on every side, doubled at the top of the upper band so the ridge never touches a rule.</p>
              </div>
              <div>
                <h4>Never</h4>
                <p>Recolour the two bands differently, close the aperture, rotate the mark, or set it below 16 units.</p>
              </div>
              <div>
                <h4>Below 24px</h4>
                <p>Switch to the compact drawing. The 64-unit mark loses its aperture to anti-aliasing at 16.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 03 · COLOUR ======================================================= */}
      <section class="ar-sec" id="colour">
        <div class="ar-sec__wrap">
          <div class="ar-rail">
            <span class="ar-rail__n">03</span>
            <span class="ar-rail__l">Colour</span>
          </div>
          <div class="ar-body">
            <h2 class="ar-h2">One ultramarine, one blaze, three honest failures.</h2>
            <p class="ar-big">
              Twelve primitives named for the material, never for the mode. Three of the fourteen
              measured pairs fail, they are printed as failures, and each one is restricted to a
              graphic job it can actually do.
            </p>

            <div class="ar-sw-grid">
              {tokens.primitives.map((p) => (
                <button class="ar-sw" type="button" data-copy={p.value}>
                  <span class="ar-sw__chip" style={`background:${p.value}`} aria-hidden="true"></span>
                  <span class="ar-sw__name">{p.name}</span>
                  <span class="ar-sw__hex">{p.value}</span>
                  <span class="ar-sw__role">{p.role}</span>
                </button>
              ))}
            </div>

            <h3 class="ar-h3">Measured contrast ledger</h3>
            <div class="ar-pairs">
              {tokens.contrast.map((c) => (
                <div class={`ar-pair${c.pass ? '' : ' ar-pair--fail'}`}>
                  <span class="ar-pair__chips" aria-hidden="true">
                    <i style={`background:${tokens.primitives.find((p) => p.name === c.fg)?.value ?? '#000'}`}></i>
                    <i style={`background:${tokens.primitives.find((p) => p.name === c.bg)?.value ?? '#fff'}`}></i>
                  </span>
                  <span class="ar-pair__label">
                    <b>{c.fg} on {c.bg}</b>
                    <span>{c.role}</span>
                  </span>
                  <span class="ar-pair__ratio">{c.ratio.toFixed(1)}:1</span>
                  <span class={`ar-pair__verdict${c.pass ? '' : ' is-fail'}`}>{c.pass ? 'Pass' : 'Fail'}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* 04 · SURFACES ===================================================== */}
      <section class="ar-sec" id="surfaces">
        <div class="ar-sec__wrap">
          <div class="ar-rail">
            <span class="ar-rail__n">04</span>
            <span class="ar-rail__l">Surfaces</span>
          </div>
          <div class="ar-body">
            <h2 class="ar-h2">Six sheets, five that hold.</h2>
            <p class="ar-big">
              Each surface below is a real treatment rendered in CSS, not a swatch. The rejected one
              is kept on the page so nobody re-proposes it in six months.
            </p>

            <div class="ar-surf">
              {SURFACES.map((s) => (
                <article class={`ar-sc${s.rejected ? ' ar-sc--rej' : ''}`}>
                  <div class={`ar-demo ar-demo--${s.demo}`} aria-hidden="true">
                    {s.demo === 'cut' && <span class="ar-demo__sheet">Cut sheet</span>}
                    {s.demo === 'lifted' && (
                      <>
                        <span class="ar-demo__lift ar-demo__lift--a"></span>
                        <span class="ar-demo__lift ar-demo__lift--b"></span>
                        <span class="ar-demo__lift ar-demo__lift--c"></span>
                      </>
                    )}
                    {s.demo === 'vellum' && <span class="ar-demo__vellum"><b>88% paper</b><i>blur(18px)</i></span>}
                    {s.demo === 'deckle' && <span class="ar-demo__deckle"></span>}
                    {s.demo === 'register' && <span class="ar-demo__reg">Aiguille</span>}
                    {s.demo === 'stipple' && <span class="ar-demo__stip"></span>}
                  </div>
                  <div class="ar-sc__txt">
                    <header>
                      <b>{s.title}</b>
                      <span class="ar-sc__verdict">{s.verdict}</span>
                    </header>
                    <p>{s.note}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* 05 · TYPE ========================================================= */}
      <section class="ar-sec" id="type">
        <div class="ar-sec__wrap">
          <div class="ar-rail">
            <span class="ar-rail__n">05</span>
            <span class="ar-rail__l">Type</span>
          </div>
          <div class="ar-body">
            <h2 class="ar-h2">Bodoni draws the ridge. Plex measures it.</h2>
            <p class="ar-big">
              Three voices and no fourth: a high-contrast didone for the sheet titles, a neutral
              grotesque for the reading column, and one monospace for every coordinate, elevation
              and price on the page.
            </p>

            <div class="ar-tscale">
              {TYPE_SCALE.map((t) => (
                <div class="ar-tscale__row">
                  <div class="ar-tscale__meta">
                    <b>{t.role}</b>
                    <span>{t.token}</span>
                    <span>{t.weight} · {t.lh} lh · {t.ls}</span>
                  </div>
                  <div
                    class={`ar-tscale__sample ar-tscale__sample--${t.token.replace('--ar-t-', '')}`}
                    style={`font-size:${t.clamp};line-height:${t.lh};letter-spacing:${t.ls};font-weight:${t.weight}`}
                  >
                    {t.sample}
                  </div>
                </div>
              ))}
            </div>

            <div class="ar-specs">
              <div class="ar-spec">
                <h4>Display</h4>
                <p class="ar-spec__display">Aiguille<br /><em>du Midi</em></p>
                <span>Bodoni Moda 400 · tight tracking · display only, never below 32px</span>
              </div>
              <div class="ar-spec">
                <h4>Reading</h4>
                <p class="ar-spec__read">
                  The route crosses three huts and one col. Each edition is cut from the same two
                  papers, registered by hand, and numbered on the sheet corner in graphite. Reading
                  measure stays between sixty and sixty-six characters.
                </p>
                <span>Instrument Sans 400 · 62ch measure · 1.6 leading</span>
              </div>
              <div class="ar-spec">
                <h4>Figures</h4>
                <table class="ar-spec__fig">
                  <tbody>
                    <tr><td>Distance</td><td>11.4</td><td>km</td></tr>
                    <tr><td>Ascent</td><td>1,486</td><td>m</td></tr>
                    <tr><td>High point</td><td>3,842</td><td>m</td></tr>
                    <tr><td>Fee</td><td>240</td><td>CHF</td></tr>
                  </tbody>
                </table>
                <span>IBM Plex Mono 500 · tabular nums · right aligned</span>
              </div>
              <div class="ar-spec">
                <h4>Labels</h4>
                <p class="ar-spec__lbl">Plate 01 · the traverse</p>
                <p class="ar-spec__lbl">46°12′N 07°04′E</p>
                <p class="ar-spec__lbl">Sheet 05 · 1:25 000</p>
                <span>Plex Mono 500 · 0.14em tracking · uppercase · 10–11px</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 06 · KIT ========================================================== */}
      <section class="ar-sec" id="kit">
        <div class="ar-sec__wrap">
          <div class="ar-rail">
            <span class="ar-rail__n">06</span>
            <span class="ar-rail__l">Kit</span>
          </div>
          <div class="ar-body">
            <h2 class="ar-h2">Controls cut from the same sheet.</h2>
            <p class="ar-big">
              Four components, each with a state that has to be legible at 12px in daylight and at
              dusk: buttons, survey chips, a permit field with a real error, and the route table.
            </p>

            <div class="ar-kit">
              <div class="ar-kit__cell">
                <h4>Buttons</h4>
                <div class="ar-btns">
                  <button class="ar-btn ar-btn--solid" type="button">Reserve a hut</button>
                  <button class="ar-btn ar-btn--ghost" type="button">Print the sheet</button>
                  <button class="ar-btn ar-btn--solid ar-btn--sm" type="button">Small</button>
                  <button class="ar-btn ar-btn--ghost" type="button" disabled>Sold out</button>
                </div>
              </div>

              <div class="ar-kit__cell">
                <h4>Survey chips</h4>
                <div class="ar-chips">
                  <span class="ar-chip"><i class="ar-dot"></i>Open</span>
                  <span class="ar-chip"><i class="ar-dot ar-dot--blaze"></i>Blaze only</span>
                  <span class="ar-chip"><i class="ar-dot ar-dot--mute"></i>Closed</span>
                  <span class="ar-chip ar-chip--on">Selected</span>
                </div>
                <p class="ar-kitnote">Every chip carries a dot or a fill: colour alone is never the label at 12px.</p>
              </div>

              <div class="ar-kit__cell">
                <h4>Permit field</h4>
                <label class="ar-field">
                  <span>Party name</span>
                  <input type="text" value="B. Vionnet" aria-invalid="true" aria-describedby="ar-err" />
                  <em id="ar-err">Required: name on the permit, not the booking.</em>
                </label>
                <label class="ar-field ar-field--ok">
                  <span>Nights</span>
                  <input type="text" value="3" />
                </label>
              </div>

              <div class="ar-kit__cell">
                <h4>Route table</h4>
                <table class="ar-table" id="arTable">
                  <thead>
                    <tr><th scope="col">Route</th><th scope="col">Grade</th><th scope="col">High</th><th scope="col">Fee</th></tr>
                  </thead>
                  <tbody>
                    {ROUTES.map((r, i) => (
                      <tr tabindex="0" class={i === 0 ? 'is-on' : ''} data-fee={r.fee}>
                        <td>
                          <b>{r.name}</b>
                          <span>{r.meta}</span>
                        </td>
                        <td>{r.grade}</td>
                        <td>{r.high}</td>
                        <td>{r.fee} CHF</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="ar-kitnote">Click a row to select it. Three rows maximum — a fourth pushes the table into a permit sheet.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* cast band · full-bleed inverted, between 06 and 07 */}
      <section class="ar-cast" aria-labelledby="ar-cast-h">
        <div class="ar-cast__wrap">
          <div class="ar-rail ar-rail--rev">
            <span class="ar-rail__n">Cast</span>
            <span class="ar-rail__l">Six cut marks</span>
          </div>
          <div class="ar-body">
            <h2 class="ar-h2 ar-h2--rev" id="ar-cast-h">Six nouns from the mountain.</h2>
            <p class="ar-big ar-big--rev">
              Every companion mark is drawn on the same 64-unit grid with the same cut-line weight
              as the primary, so a hut and a summit read as the same hand.
            </p>
            <div class="ar-cast__grid">
              {CAST_ITEMS.map((c) => (
                <figure class="ar-cast__cell">
                  <img src={`${B}/cast/${c.id}.svg`} alt={`The ${c.name} companion mark.`} width="64" height="64" />
                  <figcaption>
                    <b>{c.name}</b>
                    <span>{c.role}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* 07 · TOKENS ======================================================= */}
      <section class="ar-sec" id="tokens">
        <div class="ar-sec__wrap">
          <div class="ar-rail">
            <span class="ar-rail__n">07</span>
            <span class="ar-rail__l">Tokens</span>
          </div>
          <div class="ar-body">
            <h2 class="ar-h2">Five sheets, one namespace.</h2>
            <p class="ar-big">
              Primitives never move between scopes; the two semantic blocks are the only place a
              colour is allowed to change meaning. Both scopes ship, so both get a sheet.
            </p>

            <div class="ar-sheets">
              {SHEETS.map((s) => (
                <div class="ar-sheet">
                  <header>
                    <span class="ar-sheet__n">{s.n}</span>
                    <b>{s.title}</b>
                    <button class="ar-copy" type="button" data-code={s.code}>Copy</button>
                  </header>
                  <pre><code>{s.code}</code></pre>
                </div>
              ))}
            </div>

            <h3 class="ar-h3">What is verified, and what is not</h3>
            <div class="ar-gaps">
              {GAPS.map((g) => (
                <div class="ar-gap">
                  <h4>{g.t}</h4>
                  <p>{g.d}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>

    {/* footer: F2 · reversed split — the framed range returns on the left under
        a two-axis scrim with the reverse lockup on it, the closing statement and
        real links on the right, then a thin bar. Nothing else. */}
    <footer class="ar-foot">
      <div class="ar-foot__split">
        <figure class="ar-foot__art">
          <img
            src={`${B}/arete-closing.webp`}
            alt="The same ridge at dusk: the summit cut into a pale evening sky above a dark timber line."
            width="1672"
            height="941"
            loading="lazy"
          />
          <div class="ar-foot__scrim" aria-hidden="true"></div>
          <img class="ar-foot__lock" src={`${B}/lockup-reverse.svg`} alt="Arête" height="26" />
          <figcaption>Plate 02 · the closing cut</figcaption>
        </figure>

        <div class="ar-foot__say">
          <p class="ar-foot__eyebrow">Edition of 240 · printed in Valais</p>
          <p class="ar-foot__sign">The page ends on the ridge,<br />the way the sheet does.</p>
          <p class="ar-foot__sub">
            Two papers, one impression, and a 5-unit knife. Everything above is a consequence of
            that sentence.
          </p>
          <nav class="ar-foot__links" aria-label="Arête downloads">
            <a href={`${B}/arete-brandkit.png`}>Brand kit PNG</a>
            <a href={`${B}/arete-figma.html`}>Figma HTML sheet</a>
            <a href={`${B}/tokens.json`}>tokens.json</a>
            <a href={`${B}/arete-tokens.css`}>Tokens CSS</a>
            <a href={`${B}/DESIGN.md`}>DESIGN.md</a>
          </nav>
        </div>
      </div>

      <div class="ar-foot__bar">
        <div class="ar-foot__barin">
          <span>Arête · case {tokens.meta.case}</span>
          <span>Zermatt, Valais · 2026 · V{tokens.meta.version}</span>
          <a href="#top">Back to the top</a>
        </div>
      </div>
    </footer>
  </div>

  <script is:inline>
    const root = document.querySelector('.ar-root')
    const btn = document.getElementById('arScope')
    const label = document.getElementById('arScopeLabel')

    const setScope = (scope) => {
      root.setAttribute('data-ar', scope)
      const dusk = scope === 'dusk'
      btn.setAttribute('aria-pressed', String(dusk))
      label.textContent = dusk ? 'Ultramarine dusk' : 'Ivory stock'
      try {
        localStorage.setItem('ar-scope', scope)
      } catch (e) {}
    }

    setScope(localStorage.getItem('ar-scope') === 'dusk' ? 'dusk' : 'day')
    btn.addEventListener('click', () => {
      setScope(root.getAttribute('data-ar') === 'dusk' ? 'day' : 'dusk')
    })

    document.querySelectorAll('[data-copy]').forEach((el) => {
      el.addEventListener('click', async () => {
        const text = el.getAttribute('data-copy')
        try {
          await navigator.clipboard.writeText(text)
          el.classList.add('is-copied')
          setTimeout(() => el.classList.remove('is-copied'), 900)
        } catch (e) {}
      })
    })

    document.querySelectorAll('[data-code]').forEach((el) => {
      el.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(el.getAttribute('data-code'))
          const prev = el.textContent
          el.textContent = 'Copied'
          setTimeout(() => (el.textContent = prev), 900)
        } catch (e) {}
      })
    })

    const table = document.getElementById('arTable')
    table?.querySelectorAll('tbody tr').forEach((row) => {
      const pick = () => {
        table.querySelectorAll('tbody tr').forEach((r) => r.classList.remove('is-on'))
        row.classList.add('is-on')
      }
      row.addEventListener('click', pick)
      row.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          pick()
        }
      })
    })
  </script>
</Layout>
