---
import Layout from '@/layouts/Layout.astro'
import tokens from '@/features/serenica/tokens.json'
import '@/features/serenica/serenica-tokens.css'
import '@/features/serenica/serenica-page.css'
import SerenicaField from '@/components/ui/serenica-field.tsx'
import MeadowRiseFooter from '@/components/ui/meadow-rise-footer.tsx'

const B = '/brand/serenica'
const title = 'Serenica — Case 23 | Confidential support · Live field above the type'
const description =
  'Serenica: a listening service printed like a field journal. Six flat ridge inks, a petal rosette cut from one disc, one marigold accent, a live painted field over the type, and a contrast ledger that publishes the three pairs it fails.'

const NAV = [
  { id: 'premise', label: 'Premise' },
  { id: 'mark', label: 'Mark' },
  { id: 'ink', label: 'Ink' },
  { id: 'surfaces', label: 'Surfaces' },
  { id: 'type', label: 'Type' },
  { id: 'kit', label: 'Kit' },
  { id: 'tokens', label: 'Tokens' },
]

const CAST = [
  { id: 'ridge', name: 'Ridge', note: 'Six bands of depth, read front to back' },
  { id: 'petal', name: 'Petal', note: 'The unit the mark is counted in' },
  { id: 'stem', name: 'Stem', note: 'One line up, two leaves off it' },
  { id: 'mist', name: 'Mist', note: 'Haze between two ridges' },
  { id: 'hour', name: 'Hour', note: 'A session, cut out of the day' },
  { id: 'hold', name: 'Hold', note: 'Two sides keeping a space open' },
]

const PREMISE = [
  {
    h: 'Belief',
    p: 'Help should arrive the way weather does — without paperwork, without a queue, and without asking anyone to explain themselves twice.',
  },
  {
    h: 'Enemy',
    p: 'Triage chrome: risk-score meters, a waiting-room counter, a chatbot with a face, and a “how are you feeling, one to five” scale at the door.',
  },
  {
    h: 'Material',
    p: 'Uncoated stock #F4F2E9, six ridge inks from sage to ground, one marigold #D99A2B, Instrument Serif at 400, Inter Tight for anything read at speed.',
  },
  {
    h: 'The rejection test',
    p: 'If a surface makes the service look clinical, or the page look busy, reject it. Calm is a layout decision before it is a colour.',
    loud: true,
  },
]

const DECISIONS = [
  {
    title: 'The field is painted, not photographed',
    decision:
      'Six ridges are drawn per pixel from one seed and composited. The hero and the footer are the same range at the same seed; the hero is live, the footer is held.',
    because:
      'A stock photograph of hills puts a real place behind a confidential service, and every competitor can license the same frame. A drawn range belongs to the brand and survives any width without a crop.',
    notWhen: 'A campaign names a real location — then it is photography, and it sits in a plate, never behind the headline.',
    breaksNext: 'Someone swaps in a stock meadow “for warmth” and the footer stops matching the hero.',
  },
  {
    title: 'Six ridges, never five',
    decision:
      'The range is always six bands, farthest to nearest, sage to ground. The count is the composition: five reads as a hill, seven reads as a texture.',
    because:
      'Depth is what makes the scene read as distance rather than decoration, and six is the smallest count where aerial haze can work between two adjacent bands.',
    notWhen: 'The mark and the cast. They are flat, one ink, and carry no depth at all.',
    breaksNext: 'Adding a seventh “for richness” and losing the crease between bands three and four.',
  },
  {
    title: 'Marigold is the action, and nothing else',
    decision:
      'The accent appears on the primary action and on the footer’s action. It measures 2.18:1 on stock, so it can never be type; it is a fill that carries ink at 8.4:1.',
    because:
      'The palette is six greens. A second green accent would vanish into the ridges; a warm accent is the one flower in the field, and it only ever means “this is the way in”.',
    notWhen: 'Charts, status dots, links, headings. A marigold link is a broken promise about where to click.',
    breaksNext: 'Using marigold for a hover state, which teaches the eye that the accent means “somewhere” rather than “here”.',
  },
  {
    title: 'Day and night are one sheet, not two brands',
    decision:
      'The night scope drops the paper to #0F1611 and lifts the ink to #E7EBE1. Every primitive keeps its value; only the semantic layer moves. Marigold survives both scopes untouched.',
    because:
      'A service reached at three in the morning cannot be a different product from the one reached at noon. The scope is a lamp, not a redesign.',
    notWhen: 'Print, favicons and the brand board — they are always the daylight sheet.',
    breaksNext: 'Re-mixing the greens for night until the ridges stop reading as the same range.',
  },
]

const SURFACES = [
  {
    title: 'Flat stock',
    verdict: 'Shipped — the page',
    p: 'One solid ground, edge to edge, and a single hairline where a rule is genuinely a rule. The whole page is this surface; the other three are moments inside it.',
    demo: 'stock',
  },
  {
    title: 'Six-ridge band',
    verdict: 'Shipped — hero and footer',
    p: 'Six flat inks, farthest to nearest, with the light fixed at one angle. The same seed opens and closes the page, which is the only “imagery” the brand owns.',
    demo: 'ridge',
  },
  {
    title: 'Printed grain',
    verdict: 'Shipped — the field',
    p: 'A per-pixel pass adds mottle, clump and grain, so a flat fill reads as ink on stock rather than a vector rectangle. At 100% it is invisible; at 200% it is the material.',
    demo: 'grain',
  },
  {
    title: 'Hard ground edge',
    verdict: 'Shipped — the footer seam',
    p: 'The nearest ridge stops dead against the footer ground instead of fading into it. One line, no gradient: the point where the field becomes the page you can read on.',
    demo: 'seam',
  },
  {
    title: 'Sky wash',
    verdict: 'Rejected',
    p: 'The source component’s atmospheric sky — a soft vertical gradient with a glow that follows the pointer. It photographs beautifully and prints badly: it needs a screen to exist, and it made every headline look like a landing page.',
    demo: 'wash',
    rejected: true,
  },
  {
    title: 'Frosted plate',
    verdict: 'Rejected',
    p: 'A blurred pane over the field, carrying the reading text. Legible, expensive, and the exact glass card the house rules ban — the field became wallpaper behind a rectangle instead of the thing you are standing in.',
    demo: 'glass',
    rejected: true,
  },
]

const GAPS = [
  {
    h: 'Verified — contrast',
    p: `${tokens.contrast.length} pairs computed from hex in the build script, not asserted. ${tokens.meta.failingPairs} fail 4.5:1 and are published in §03 with a job that is not type.`,
  },
  {
    h: 'Verified — the field',
    p: 'Painted at 1×, 1.25× and 1.5× device density, six ridges, at widths from 390 to 1920. The footer repaints on resize rather than scaling a bitmap.',
  },
  {
    h: 'Not verified — the service',
    p: 'No session data from the real product. The hero’s four figures are illustrative of the brand, not a measurement of Serenica, which does not exist.',
  },
  {
    h: 'Known gap — night field',
    p: 'In the night scope the six ridge inks sit within 1.4:1 of one another, so the range reads as one dark mass at low screen brightness. The daylight sheet is the reference; night is a lamp on it.',
  },
]

const LISTENERS = [
  { name: 'Ada O.', lang: 'English · Yoruba', wait: '3m 40s', open: true },
  { name: 'Mira K.', lang: 'English · Polish', wait: '5m 10s', open: true },
  { name: 'Tomas R.', lang: 'Portuguese · English', wait: '—', open: false },
  { name: 'Ines L.', lang: 'Spanish · Catalan', open: true, wait: '2m 55s' },
]

const sizeLabel = (v: string) => {
  const m = v.match(/([\d.]+)px/g)
  if (!m) return v
  const nums = m.map((x) => x.replace('px', ''))
  return nums.length > 1 ? `${nums[1]} → ${nums[0]}` : `${nums[0]}px`
}

const cssPrimitives = `/* 1 · primitive — the material, named once */
:root {
${tokens.primitives
  .map((p) => `  --sr-${p.name}: ${p.value}; /* ${p.oklch} */`)
  .join('\n')}
}`

const cssDay = `/* 2 · semantic · daylight field (default) */
:root {
  --sr-bg-canvas: var(--sr-paper);
  --sr-bg-plate: var(--sr-chalk);
  --sr-bg-band: var(--sr-haze);
  --sr-ink-primary: var(--sr-ink);
  --sr-ink-secondary: var(--sr-umber);
  --sr-line-strong: rgba(17, 20, 13, 0.28);
  --sr-line-subtle: rgba(17, 20, 13, 0.12);
  --sr-accent: var(--sr-marigold);
}`

const cssNight = `/* 3 · semantic · night field — a lamp, not a redesign */
[data-sr='night'] {
  --sr-bg-canvas: #0F1611;
  --sr-bg-plate: #18211A;
  --sr-bg-band: #1F2A20;
  --sr-ink-primary: #E7EBE1;
  --sr-ink-secondary: #A9B49C;
  --sr-line-strong: rgba(231, 235, 225, 0.16);
  --sr-line-subtle: rgba(231, 235, 225, 0.09);
  --sr-accent: var(--sr-marigold);
}`

const cssComponent = `/* 4 · component — the action carries the one accent */
.sr-btn {
  height: 46px;
  padding: 0 22px;
  border: 0;
  border-radius: 0;
  background: var(--sr-accent);
  color: var(--sr-accent-ink);
  font-family: var(--sr-font-reading);
  font-size: 13.5px;
  font-weight: 500;
}
.sr-sheet { background: var(--sr-bg-loud); color: var(--sr-ink-reverse); }`

const cssPhysics = `/* 5 · physics — printed matter */
:root {
  --sr-radius: 0px;
  --sr-rule: 1px;
  --sr-wrap: 1200px;
  --sr-gutter: clamp(20px, 4vw, 56px);
  --sr-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  --sr-transition: 260ms var(--sr-ease);
}
/* no shadow at rest, anywhere. a printed sheet casts nothing. */`
---

<Layout title={title} description={description} canonical="/design-system/serenica" image={`${B}/serenica-brandkit.png`}>
  <div class="sr" id="top" data-sr="day">
    <script is:inline>
      try {
        if (localStorage.getItem('sr-theme') === 'night') {
          document.querySelector('.sr')?.setAttribute('data-sr', 'night')
          document.documentElement.classList.add('dark')
        }
      } catch (e) {}
    </script>

    <!-- nav: mark, name, word-only section links, one scope toggle. no numbers. -->
    <header class="sr-bar">
      <div class="sr-wrap sr-bar__in">
        <a class="sr-bar__brand" href="#top" aria-label="Serenica, back to top">
          <img src={`${B}/mark.svg`} width="22" height="22" alt="" />
          <span class="sr-bar__name">Serenica</span>
          <span class="sr-bar__case">Case 23</span>
        </a>
        <nav class="sr-bar__nav" aria-label="Serenica sections">
          {NAV.map((n) => <a href={`#${n.id}`} data-nav={n.id}>{n.label}</a>)}
        </nav>
        <button class="sr-theme" id="srTheme" type="button" aria-pressed="false">
          <span class="sr-theme__dot" aria-hidden="true"></span>
          <span id="srThemeLabel">Daylight</span>
        </button>
      </div>
    </header>

    <main>
      <!-- ===============================================================
           HERO · C · relation below — the live field runs first, full
           width; the type sits underneath it on the page ground.
           =============================================================== -->
      <section class="sr-stage" aria-label="The field">
        <SerenicaField client:load theme="auto" seed={3} height="clamp(300px, 44vh, 440px)" stamp="Field 01 · six ridges · seed 3 · 1:1" />
        <span class="sr-stage__edge">the same object closes the page</span>
      </section>

      <section class="sr-open">
        <div class="sr-wrap sr-open__grid">
          <div>
            <h1>Some hours are heavier than the day can hold.</h1>
            <p class="sr-lede">
              Serenica is a listening service for the hours that will not lift on their own. One
              conversation with a trained listener, no case file, nothing kept after you close the tab.
            </p>
            <div class="sr-acts">
              <a class="sr-btn" href="#kit">
                Start a conversation
                <span class="sr-btn__arw" aria-hidden="true">↗</span>
              </a>
              <a class="sr-btn sr-btn--ghost" href="#premise">Read the premise →</a>
            </div>
          </div>
          <dl class="sr-facts">
            <div><dt>Median wait</dt><dd>4 min 10 s</dd></div>
            <div><dt>Trained listeners</dt><dd>240</dd></div>
            <div><dt>Kept after a session</dt><dd>Nothing</dd></div>
            <div><dt>Languages</dt><dd>11</dd></div>
          </dl>
        </div>
      </section>

      <div class="sr-wrap">
        <div class="sr-shell">
          <!-- Rail B · one contents list for the whole page -->
          <nav class="sr-contents" aria-label="Contents">
            <ol>
              {NAV.map((n, i) => (
                <li>
                  <a href={`#${n.id}`} data-spy={n.id}>
                    <span class="n">{String(i + 1).padStart(2, '0')}</span>
                    <span class="lbl">{n.label}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="sr-contents__foot">
              Six ridges, twelve primitives, one accent. Printed on uncoated stock.
            </p>
          </nav>

          <div class="sr-sections">
            <!-- 01 ───────────────────────────────────────────────────── -->
            <section id="premise" class="sr-sec">
              <div class="sr-head">
                <h2>A support brand should feel like weather, not a form.</h2>
                <p>
                  The page is printed, not rendered: uncoated stock, six flat inks, one marigold, and
                  no shadow anywhere — a printed sheet casts nothing, and someone in a hard hour does
                  not need a product performing at them.
                </p>
              </div>

              <div class="sr-cells">
                {PREMISE.map((c) => (
                  <div class={`sr-cell${c.loud ? ' sr-cell--loud' : ''}`}>
                    <h3>{c.h}</h3>
                    <p>{c.p}</p>
                  </div>
                ))}
              </div>

              <div class="sr-decs">
                {DECISIONS.map((d) => (
                  <article class="sr-dec">
                    <h4>{d.title}</h4>
                    <dl>
                      <dt>Decision</dt>
                      <dd>{d.decision}</dd>
                      <dt>Because</dt>
                      <dd>{d.because}</dd>
                      <dt>Not when</dt>
                      <dd>{d.notWhen}</dd>
                      <dt>Breaks next</dt>
                      <dd><em>Breaks when:</em> {d.breaksNext}</dd>
                    </dl>
                  </article>
                ))}
              </div>
            </section>

            <!-- 02 ───────────────────────────────────────────────────── -->
            <section id="mark" class="sr-sec">
              <div class="sr-head">
                <h2>A ring, a disc, eight petals cut out of it.</h2>
                <p>
                  The rosette in the source component was eight ellipses and a circle drawn in a thin
                  stroke. Redrawn on the 64 grid it becomes one solid disc with eight petal-shaped
                  holes, a 4.6-unit ring outside it, and a 2.2-unit eye. One fill, no strokes, no
                  illustration: a disc that has been cut eight times.
                </p>
              </div>

              <div class="sr-logos">
                <div class="sr-logo">
                  <img src={`${B}/mark.svg`} width="84" height="84" alt="Serenica primary mark" />
                  <span>Primary · 64 grid</span>
                </div>
                <div class="sr-logo sr-logo--loud">
                  <img src={`${B}/mark-reverse.svg`} width="84" height="84" alt="Serenica reverse mark on the ground" />
                  <span>Reverse · on ground</span>
                </div>
                <div class="sr-logo">
                  <img src={`${B}/mark-compact.svg`} width="84" height="84" alt="Serenica compact mark, four wide cuts" />
                  <span>Compact · 16–24px</span>
                </div>
                <div class="sr-logo sr-logo--glyph">
                  <img src={`${B}/glyph.svg`} width="96" height="96" alt="Serenica glyph, the rosette without its ring" />
                  <span>Glyph · pattern</span>
                </div>
              </div>

              <div class="sr-scale">
                <figure>
                  <img src={`${B}/mark.svg`} width="96" height="96" alt="" />
                  <figcaption>96 · full</figcaption>
                </figure>
                <figure>
                  <img src={`${B}/mark.svg`} width="48" height="48" alt="" />
                  <figcaption>48 · full</figcaption>
                </figure>
                <figure>
                  <img src={`${B}/mark.svg`} width="32" height="32" alt="" />
                  <figcaption>32 · full</figcaption>
                </figure>
                <figure>
                  <img src={`${B}/mark-compact.svg`} width="24" height="24" alt="" />
                  <figcaption>24 · compact</figcaption>
                </figure>
                <figure>
                  <img src={`${B}/mark-compact.svg`} width="16" height="16" alt="" />
                  <figcaption>16 · compact</figcaption>
                </figure>
                <figure>
                  <img src={`${B}/glyph.svg`} width="16" height="16" alt="" />
                  <figcaption>16 · glyph</figcaption>
                </figure>
              </div>

              <div class="sr-locks">
                <div class="sr-lock">
                  <p>Horizontal lockup · mark 64, wordmark 40 cap, 16u gap</p>
                  <div class="sr-lock__art">
                    <img src={`${B}/lockup.svg`} height="34" alt="Serenica horizontal lockup" />
                  </div>
                </div>
                <div class="sr-lock">
                  <p>Reverse lockup · on the ground</p>
                  <div class="sr-lock__art" style="background: var(--sr-bg-loud); padding: 18px 22px; display:inline-flex; width:fit-content;">
                    <img src={`${B}/lockup-reverse.svg`} height="34" alt="Serenica reverse lockup" />
                  </div>
                </div>
                <div class="sr-lock">
                  <p>Stacked lockup · square placements and covers</p>
                  <div class="sr-lock__art">
                    <img class="sr-lock--tall" src={`${B}/lockup-stacked.svg`} height="96" alt="Serenica stacked lockup" />
                  </div>
                </div>
              </div>

              <div class="sr-rules">
                <div>
                  <h4>Clear space</h4>
                  <p>Eight units on every side, measured from the ring. Nothing enters it — not a rule, not a caption, not the edge of a photograph.</p>
                </div>
                <div>
                  <h4>Never</h4>
                  <p>No outline version, no rotation, no second colour, no petals added or removed. The mark is a cut, not a drawing, so it cannot be “adjusted”.</p>
                </div>
                <div>
                  <h4>Below 24px</h4>
                  <p>Swap to the compact file. It is a separate drawing: a thicker ring, four wide cuts, no eye. Scaling the 64px master down turns the petals into a smudge.</p>
                </div>
              </div>

              <!-- the cast belongs to the mark argument, not to the end of the page -->
              <div class="sr-cast">
                <div class="sr-cast__head">
                  <h3>The companion cast</h3>
                  <p>Six nouns from the service’s own vocabulary · one cut line, one flat fill, one job each</p>
                </div>
                <div class="sr-cast__grid">
                  {CAST.map((c) => (
                    <div class="sr-cast__cell">
                      <img src={`${B}/cast/${c.id}.svg`} width="26" height="26" alt="" />
                      <b>{c.name}</b>
                      <span>{c.note}</span>
                    </div>
                  ))}
                </div>
              </div>
            </section>

            <!-- 03 ───────────────────────────────────────────────────── -->
            <section id="ink" class="sr-sec">
              <div class="sr-head">
                <h2>Six greens, one marigold, and the three pairs that fail.</h2>
                <p>
                  Twelve primitives, each named for the material it stands for. The ledger below is
                  computed from hex, not asserted. Three pairs do not reach 4.5:1, they are published
                  here, and each is assigned a job that is not type. Click any swatch to copy its hex.
                </p>
              </div>

              <div class="sr-swatches">
                {tokens.primitives.map((p) => (
                  <button class="sr-swatch" type="button" data-hex={p.value} aria-label={`Copy ${p.name} ${p.value}`}>
                    <span class="sr-swatch__chip" style={`background:${p.value}`}></span>
                    <span class="sr-swatch__body">
                      <span class="sr-swatch__name">{p.name}</span>
                      <span class="sr-swatch__hex">{p.value} · {p.oklch}</span>
                      <span class="sr-swatch__role">{p.role}</span>
                    </span>
                    <span class="sr-swatch__copied">copied</span>
                  </button>
                ))}
              </div>

              <div class="sr-ledger">
                <h3>Measured contrast</h3>
                <p>
                  WCAG 2.1, computed from sRGB hex. Fails are not nudged into mud to fake a pass —
                  they are given a graphic-only job and printed here.
                </p>
                <div class="sr-ledger__rows">
                  {tokens.contrast.map((c) => (
                    <div class="sr-pair" data-pass={String(c.pass)}>
                      <span class="sr-pair__chips" aria-hidden="true">
                        <i style={`background:${c.fgHex}`}></i>
                        <i style={`background:${c.bgHex}`}></i>
                      </span>
                      <span class="sr-pair__name">{c.fg} on {c.bg}</span>
                      <span class="sr-pair__job">{c.job}</span>
                      <span class="sr-pair__ratio">
                        <b>{c.ratio}:1</b>
                        {!c.pass && <span class="sr-pair__flag">fail</span>}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </section>

            <!-- 04 ───────────────────────────────────────────────────── -->
            <section id="surfaces" class="sr-sec">
              <div class="sr-head">
                <h2>Six surfaces were tried. Four survived.</h2>
                <p>
                  Each card is the treatment itself, live, not a screenshot. The two rejected cards
                  are the two most tempting ones: an atmospheric sky wash, and a frosted plate over
                  the field. Both are named so nobody proposes them again in six months.
                </p>
              </div>

              <div class="sr-surfs">
                {SURFACES.map((s) => (
                  <article class="sr-sc" data-rejected={String(!!s.rejected)}>
                    <div class="sr-sc__demo">
                      {s.demo === 'stock' && (
                        <div class="sr-demo-stock"><b>Heavier hours</b></div>
                      )}
                      {s.demo === 'ridge' && (
                        <div class="sr-demo-ridge">
                          <span style="bottom:0;height:46%;left:-18%;right:24%;background:#c4cdb8"></span>
                          <span style="bottom:0;height:40%;left:12%;right:-26%;background:#9dae84"></span>
                          <span style="bottom:0;height:33%;left:-14%;right:8%;background:#7d8f63"></span>
                          <span style="bottom:0;height:27%;left:22%;right:-18%;background:#5e7440"></span>
                          <span style="bottom:0;height:21%;left:-24%;right:16%;background:#415325"></span>
                          <span style="bottom:0;height:15%;left:6%;right:-12%;background:#2c3b1b"></span>
                        </div>
                      )}
                      {s.demo === 'grain' && <div class="sr-demo-grain"></div>}
                      {s.demo === 'seam' && <div class="sr-demo-seam"><b>the ground, read on</b></div>}
                      {s.demo === 'wash' && <div class="sr-demo-wash"></div>}
                      {s.demo === 'glass' && <div class="sr-demo-glass"></div>}
                    </div>
                    <div class="sr-sc__txt">
                      <div class="sr-sc__top">
                        <b>{s.title}</b>
                        <span>{s.verdict}</span>
                      </div>
                      <p>{s.p}</p>
                    </div>
                  </article>
                ))}
              </div>
            </section>

            <!-- 05 ───────────────────────────────────────────────────── -->
            <section id="type" class="sr-sec">
              <div class="sr-head">
                <h2>A serif that breathes, a grotesque that files.</h2>
                <p>
                  Instrument Serif carries the headlines and the italic accent the source component
                  already used. Inter Tight carries everything read at speed, at 17px on 1.62 with a
                  46-character measure. Geist Mono appears in four places only: the rail number, the
                  field stamp, tabular figures, and these sheets.
                </p>
              </div>

              <div class="sr-tscale">
                {tokens.type.map((t) => (
                  <div class="sr-trow">
                    <div class="sr-trow__meta">
                      <b>{t.role}</b>
                      {t.face}<br />
                      {t.weight} · {sizeLabel(t.size)}<br />
                      lh {t.leading} · tr {t.tracking}
                    </div>
                    <div
                      class="sr-trow__sample"
                      style={`font-family:${
                        t.role === 'Display' || t.role === 'Headline'
