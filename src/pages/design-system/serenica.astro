                <div class="sr-kc">
                  <h3>Buttons</h3>
                  <div class="sr-kc__row">
                    <button class="sr-btn" type="button">Start a conversation <span class="sr-btn__arw" aria-hidden="true">↗</span></button>
                    <button class="sr-btn sr-btn--ghost" type="button">How it works →</button>
                  </div>
