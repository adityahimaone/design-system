    <script>
      // scope toggle — writes the attribute the CSS and both canvases read
      const root = document.querySelector('.sr')
      const btn = document.getElementById('srTheme')
      const label = document.getElementById('srThemeLabel')
      const apply = (night: boolean) => {
        root?.setAttribute('data-sr', night ? 'night' : 'day')
        document.documentElement.classList.toggle('dark', night)
        btn?.setAttribute('aria-pressed', String(night))
        if (label) label.textContent = night ? 'Night' : 'Daylight'
        try {
          localStorage.setItem('sr-theme', night ? 'night' : 'day')
        } catch (e) {}
      }
      if (root?.getAttribute('data-sr') === 'night') {
        btn?.setAttribute('aria-pressed', 'true')
        if (label) label.textContent = 'Night'
      }
      btn?.addEventListener('click', () => apply(root?.getAttribute('data-sr') !== 'night'))

      // scroll spy — contents list and nav share one observer
      const links = [...document.querySelectorAll('[data-spy]')]
      const navLinks = [...document.querySelectorAll('[data-nav]')]
      const secs = links
        .map((a) => document.getElementById(a.getAttribute('data-spy') || ''))
        .filter(Boolean)
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            const id = e.target.id
            links.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('data-spy') === id)))
            navLinks.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('data-nav') === id)))
          }
        },
        { rootMargin: '-25% 0px -60% 0px', threshold: 0 },
      )
      secs.forEach((s) => spy.observe(s))

      // click-to-copy swatches
      document.querySelectorAll('.sr-swatch').forEach((el) => {
        el.addEventListener('click', async () => {
          const hex = el.getAttribute('data-hex') || ''
          try {
            await navigator.clipboard.writeText(hex)
          } catch (e) {}
          el.setAttribute('data-copied', 'true')
          window.setTimeout(() => el.removeAttribute('data-copied'), 1100)
        })
      })

      // copy buttons on the token sheets
      document.querySelectorAll('.sr-sheet__copy').forEach((el) => {
        el.addEventListener('click', async () => {
          const text = el.getAttribute('data-copy') || ''
          try {
            await navigator.clipboard.writeText(text)
          } catch (e) {}
          const prev = el.textContent
          el.textContent = 'Copied'
          window.setTimeout(() => {
            el.textContent = prev
          }, 1200)
        })
      })

      // row selection in the kit
      document.querySelectorAll('.sr-rows tbody tr').forEach((tr) => {
        const toggle = () => {
          const on = tr.getAttribute('aria-selected') === 'true'
          tr.setAttribute('aria-selected', String(!on))
        }
        tr.addEventListener('click', toggle)
        tr.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault()
            toggle()
          }
        })
      })
    </script>
  </div>
