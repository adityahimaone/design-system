                    </p>
                    <dl style="margin:0;display:grid;grid-template-columns:auto 1fr;gap:7px 16px;font-size:12px;line-height:1.5;">
                      <dt style="opacity:.55">Primitives</dt><dd style="margin:0">{tokens.primitives.length}</dd>
                      <dt style="opacity:.55">Contrast pairs</dt><dd style="margin:0">{tokens.contrast.length} · {tokens.meta.failingPairs} fail</dd>
                      <dt style="opacity:.55">Scopes</dt><dd style="margin:0">2 · daylight, night</dd>
                      <dt style="opacity:.55">Cast</dt><dd style="margin:0">6 marks · 64 grid</dd>
                      <dt style="opacity:.55">Accents</dt><dd style="margin:0">1 · marigold, action only</dd>
                      <dt style="opacity:.55">Mark files</dt><dd style="margin:0">9 svg · 1 compact drawing</dd>
                    </dl>
                  </div>
                </div>
              </div>

              <div class="sr-gaps">
                {GAPS.map((g) => (
