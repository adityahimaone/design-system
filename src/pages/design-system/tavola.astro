---
import Layout from '@/layouts/Layout.astro'
import tokens from '@/features/tavola/tokens.json'
import '@/features/tavola/tavola-tokens.css'
import '@/features/tavola/tavola-page.css'

const B = '/brand/tavola'
const title = 'Tavola — Case 16 | Around the table · Coastal lunch in afternoon light'
const description =
  'Tavola: an unhurried coastal Mediterranean dining identity. Sunlit ivory linen, warm terracotta, blood orange zest, and an interlocking Kuwayama parametric table mark.'

const CAST_ITEMS = [
  { id: 'sol', name: 'Sol', role: 'Afternoon zenith · Terrace hours' },
  { id: 'amphora', name: 'Olivo & Olio', role: 'First-press olive oil cruet' },
  { id: 'ulivo', name: 'Ramo', role: 'Wild olive & laurel branch' },
  { id: 'calice', name: 'Calice', role: 'Volcanic white & cellar pour' },
  { id: 'onda', name: 'Marea', role: 'Tyrrhenian sea horizon' },
  { id: 'meridiana', name: 'Meridiana', role: 'Sundial shadow at 14:30' },
]

const DECISIONS = [
  {
    title: 'Field + Linen Reading Plate',
    decision: 'Coastal photography carries the display headline and reverse lockup; every paragraph over two lines sits on a woven ivory linen plate (91% opacity + 22px blur).',
    because: 'Dappled Mediterranean sunlight shifts from 1.8:1 to 11:1 across a tablecloth crop; a solid reading plate guarantees 14.8:1 AAA contrast at every viewport.',
    notWhen: 'Large display headlines (>= 40px) over the measured dark scrim.',
    breaksNext: 'Setting 13px caption copy directly over sunlit photography without a plate.',
  },
  {
    title: 'Citron is graphic-only (2.1:1 published failure)',
    decision: 'Charred Amalfi lemon (#E6A817) measures 2.1:1 against ivory linen. It is assigned the job of culinary chip and highlight bar, never text.',
    because: 'Darkening lemon until it passed 4.5:1 turns it into muddy ochre and destroys the sunlit citrus note.',
    notWhen: 'Paired as a background badge with deep espresso ink (#221A15 on #E6A817 = 8.4:1).',
    breaksNext: 'An agent uses --tv-citron for link text or small badges on light linen.',
  },
  {
    title: 'The 16px compact is a separate drawing',
    decision: 'Below 24px, the mark swaps to mark-compact.svg: the table slab thickens from 6 to 8 units and the 45° light-ray cut is omitted.',
    because: 'A 2px negative-space chamfer closes up under anti-aliasing at 16×16 favicon scale.',
    notWhen: 'Navigation headers (28px+) and hero lockups where the 45° afternoon ray cut is crisp.',
    breaksNext: 'Scaling the 64px master down to 16px without swapping the file.',
  },
  {
    title: 'Hero and footer are the same coast turned around',
    decision: 'The page opens on the sunlit terrace table (tavola-table.webp) and closes on the full-bleed coastal catch scene (tavola-dish.webp) with a floating dusk glass pane.',
    because: 'A page feels immersive when one material idea is carried to both edges rather than ending in a dead grey copyright bar.',
    notWhen: 'Print exports or standalone token sheets.',
    breaksNext: 'Trapping the surface photography inside a small side thumbnail while leaving the hero and footer flat.',
  },
]

const cssPrimitives = `/* 1 · primitive — the material, named once */
:root {
${tokens.primitives.slice(0, 9).map((p) => `  --tv-${p.name}: ${p.value}; /* ${p.oklch} */`).join('\n')}
}`

const cssDay = `/* 2 · semantic · daylight terrace (default scope) */
:root {
  --tv-bg-canvas: var(--tv-ivory);
  --tv-bg-surface: var(--tv-terrace);
  --tv-bg-elevated: var(--tv-porcelain);
  --tv-ink-primary: var(--tv-espresso);
  --tv-ink-secondary: var(--tv-cedar);
  --tv-accent-primary: var(--tv-terracotta);
  --tv-accent-secondary: var(--tv-cobalt);
}`

const cssNight = `/* 2 · semantic · evening cellar — a scope, never a second palette */
[data-tv='night'] {
  --tv-bg-canvas: #161311;
  --tv-bg-surface: #201B18;
  --tv-bg-elevated: #2C2522;
  --tv-ink-primary: #F5F1E8;
  --tv-ink-secondary: #B3A898;
  --tv-accent-primary: #E86D48;
  --tv-accent-secondary: #4D85DE;
}`

const cssPlate = `/* 3 · component — the linen reading plate over sunlit photography */
.tv-plate {
  background: color-mix(in srgb, var(--tv-bg-canvas) 91%, transparent);
  backdrop-filter: blur(22px) saturate(145%);
  border: 1px solid var(--tv-border-subtle);
  border-radius: var(--tv-radius-lg);
  box-shadow: var(--tv-shadow-plate);
}`
---

<Layout title={title} description={description} canonical="/design-system/tavola" image={`${B}/tavola-brandkit.png`}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <div class="tv" id="top">
    <script is:inline>
      try {
        if (localStorage.getItem('tv-theme') === 'night') {
          document.querySelector('.tv')?.setAttribute('data-tv', 'night')
        }
      } catch (e) {}
    </script>

    <!-- Sticky Navigation Rail -->
    <header class="tv-bar">
      <div class="tv-wrap tv-bar__inner">
        <a class="tv-bar__brand" href="#top" aria-label="Tavola, back to top">
          <img class="tv-bar__logo" src={`${B}/mark.svg`} width="26" height="26" alt="" />
          <span class="tv-bar__title">Tavola</span>
          <span class="tv-bar__badge">Case 16</span>
        </a>
        <nav class="tv-bar__nav" aria-label="Tavola Sections">
          <a href="#hero">01 Hero</a>
          <a href="#philosophy">02 Thesis</a>
          <a href="#brandmark">03 Mark &amp; Cast</a>
          <a href="#chromatic">04 Colour</a>
          <a href="#typography">05 Type</a>
          <a href="#physics">06 Refraction</a>
          <a href="#workbench">07 Workbench</a>
          <a href="#tokens">08 Tokens</a>
        </nav>
        <button id="themeToggleBtn" class="tv-theme-toggle" type="button" aria-pressed="false">
          <span class="tv-theme-dot"></span>
          <span id="themeToggleLabel">Daylight Terrace</span>
        </button>
      </div>
    </header>

    <main>
      <!-- ===================================================================
           01 / FULL-BLEED ATMOSPHERIC PLATE — type set ON the photograph
           =================================================================== -->
      <section id="hero" class="tv-hero">
        <img
          id="heroImage"
          class="tv-hero__photo"
          src={`${B}/tavola-table.webp`}
          alt="Sunlit coastal restaurant table with ivory linen tablecloth, blood orange salad, and Mediterranean sea cliff view."
          loading="eager"
        />
        <div class="tv-hero__scrim" aria-hidden="true"></div>

        <div class="tv-wrap tv-hero__inner">
          <div class="tv-hero__meta">
            <span>Case 16 · Coastal lunch</span>
            <span>40.633°N 14.602°E</span>
            <span>14:30</span>
          </div>
          <div class="tv-hero__horizon" aria-hidden="true"></div>

          <h1 class="tv-hero__headline">
            Around the table in <em>afternoon light.</em>
          </h1>

          <p class="tv-hero__lede">Ivory linen, terracotta signal, sea glass.</p>

          <div class="tv-hero__stats">
            <div class="tv-hero__stat">
              <span class="tv-hero__statfig">{tokens.primitives.length}</span>
              <span class="tv-hero__statlbl">Primitives</span>
            </div>
            <div class="tv-hero__stat">
              <span class="tv-hero__statfig">14.8:1</span>
              <span class="tv-hero__statlbl">Espresso on Ivory</span>
            </div>
            <div class="tv-hero__stat">
              <span class="tv-hero__statfig">1 + 6</span>
              <span class="tv-hero__statlbl">Mark &amp; Cast</span>
            </div>
          </div>

          <div class="tv-hero__actions">
            <a class="tv-btn" href="#workbench">Reserve Terrace Table</a>
            <a class="tv-btn tv-btn--ghost" href="#tokens">Copy OKLCH Tokens</a>
            <a class="tv-btn tv-btn--ghost" href={`${B}/tavola-figma.html`}>Figma HTML Sheet ↗</a>
            <button id="toggleHeroPhoto" class="tv-btn tv-btn--ghost" type="button">
              Swap Backdrop: Table / Catch
            </button>
          </div>
        </div>
      </section>

      <!-- ===================================================================
           02 / THESIS BEATS & 4 ARCHITECTURAL DECISION CARDS
           =================================================================== -->
      <section id="philosophy" class="tv-section">
        <div class="tv-wrap">
          <div class="tv-section__header">
            <div class="tv-section__num">02 / Thesis &amp; Spatial Mechanics</div>
            <h2 class="tv-section__title">A dining room is a frame for the coast, not a screen in front of it.</h2>
            <p class="tv-section__desc">
              Four foundational beats and four architectural decisions with explicit failure boundaries so the next engineer never turns warm linen into generic SaaS cards.
            </p>
          </div>

          <!-- 4 Thesis Beats -->
          <div class="tv-thesis-grid">
            <div class="tv-thesis-cell">
              <h3>Belief</h3>
              <p>An afternoon menu or reservation flow should feel like sitting down at an ivory-draped table by an open balcony: unhurried, tactile, and sunlit.</p>
            </div>
            <div class="tv-thesis-cell">
              <h3>Enemy</h3>
              <p>Delivery-app food chrome: saturated RGB #FF5500 badges, cramped 3-column upsell carousels, and dark-mode overlays that turn fresh citrus grey.</p>
            </div>
            <div class="tv-thesis-cell">
              <h3>Material</h3>
              <p>Bleached cellulose linen (#FAF6EE), sun-baked limestone (#F2ECE0), terracotta clay (#D85A38), and one translucent sea-glass pane.</p>
            </div>
            <div class="tv-thesis-cell tv-thesis-cell--loud">
              <h3>The Rejection Test</h3>
              <p style="color: inherit;">If a surface hides the coastal light instead of framing it with an honest linen plate, reject it.</p>
            </div>
          </div>

          <!-- 4 Decision / Because / Not when / Breaks next Cards -->
          <div class="tv-decisions-grid">
            {DECISIONS.map((d) => (
              <article class="tv-decision-card">
                <h4>{d.title}</h4>
                <dl>
                  <dt>Decision</dt>
                  <dd>{d.decision}</dd>
                  <dt>Because</dt>
                  <dd>{d.because}</dd>
                  <dt>Not when</dt>
                  <dd>{d.notWhen}</dd>
                  <dt>Breaks next</dt>
                  <dd><em>Breaks when:</em> {d.breaksNext}</dd>
                </dl>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================================================================
           03 / PARAMETRIC BRANDMARK STUDIO & 6-MARK COMPANION CAST
           =================================================================== -->
      <section id="brandmark" class="tv-section">
        <div class="tv-wrap">
          <div class="tv-section__header">
            <div class="tv-section__num">03 / Kuwayama Vector Discipline</div>
            <h2 class="tv-section__title">Parametric Brandmark Studio &amp; Cast</h2>
            <p class="tv-section__desc">
              Constructed on a 64×64 grid: a semicircular afternoon solar arc rising above a horizontal cantilever table slab, paired with a 6-mark coastal cast on the same cut line.
            </p>
          </div>

          <div class="tv-studio">
            <div id="studioStage" class="tv-studio__stage">
              <div id="gridOverlay" class="tv-studio__grid-overlay" style="display: none;"></div>
              <div class="tv-studio__svg-wrap">
                <img id="studioMarkImg" src={`${B}/mark.svg`} alt="Tavola Parametric Mark" width="180" height="180" />
              </div>

              <div class="tv-stress-strip">
                <div class="tv-stress-item">
                  <img src={`${B}/mark.svg`} width="64" height="64" alt="64px" />
                  <span>64px Master</span>
                </div>
                <div class="tv-stress-item">
                  <img src={`${B}/mark.svg`} width="32" height="32" alt="32px" />
                  <span>32px Nav</span>
                </div>
                <div class="tv-stress-item">
                  <img src={`${B}/mark-compact.svg`} width="16" height="16" alt="16px" />
                  <span>16px Compact</span>
                </div>
                <div class="tv-stress-item">
                  <div style="background-color: #221A15; padding: 6px; border-radius: 6px; display: inline-flex;">
                    <img src={`${B}/mark-reverse.svg`} width="24" height="24" alt="Reverse" />
                  </div>
                  <span>Reverse</span>
                </div>
              </div>
            </div>

            <div class="tv-studio__controls">
              <div class="tv-control-group">
                <span class="tv-control-group__label">Lockup &amp; Grid Inspection</span>
                <div class="tv-btn-pill-group">
                  <button id="toggleGridBtn" class="tv-btn-pill" type="button">8×8 Module Grid</button>
                  <button id="toggleLockupBtn" class="tv-btn-pill" type="button">Horizontal Lockup</button>
                  <button id="toggleStackedBtn" class="tv-btn-pill" type="button">Stacked Lockup</button>
                </div>
              </div>

              <div class="tv-control-group">
                <span class="tv-control-group__label">Surface Polarity Test</span>
                <div class="tv-btn-pill-group">
                  <button class="tv-btn-pill active stage-bg-btn" data-bg="surface" type="button">Limestone (#F2ECE0)</button>
                  <button class="tv-btn-pill stage-bg-btn" data-bg="ivory" type="button">Ivory (#FAF6EE)</button>
                  <button class="tv-btn-pill stage-bg-btn" data-bg="espresso" type="button">Espresso (#221A15)</button>
                  <button class="tv-btn-pill stage-bg-btn" data-bg="terracotta" type="button">Terracotta (#D85A38)</button>
                </div>
              </div>

              <div style="font-size: 0.85rem; color: var(--tv-ink-secondary); line-height: 1.55; border-top: 1px solid var(--tv-border-subtle); padding-top: 1rem;">
                <strong style="color: var(--tv-ink-primary); display: block; margin-bottom: 0.25rem;">Construction Math (64×64):</strong>
                Solar Arc: outer R=18, inner R=11 · Table Slab: y=31..37 (6u) · Pedestal: x=28..36 · Afternoon Ray Cut: 45° bevel inset.
              </div>

              <div style="margin-top: auto;">
                <button id="copySvgBtn" class="tv-btn-primary" type="button">Copy Raw SVG Markup</button>
                <div id="copyToast" style="display: none; margin-top: 0.5rem; font-family: var(--tv-font-mono); font-size: 0.72rem; color: var(--tv-accent-olive);">
                  Copied 64×64 vector SVG to clipboard.
                </div>
              </div>
            </div>
          </div>

          <!-- 6-Mark Companion Cast -->
          <div class="tv-cast-grid">
            {CAST_ITEMS.map((c) => (
              <div class="tv-cast-card">
                <img src={`${B}/cast/${c.id}.svg`} width="44" height="44" alt={c.name} />
                <b>{c.name}</b>
                <span>{c.role}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===================================================================
           04 / OKLCH CHROMATIC MATRIX & MEASURED CONTRAST LEDGER
           =================================================================== -->
      <section id="chromatic" class="tv-section">
        <div class="tv-wrap">
          <div class="tv-section__header">
            <div class="tv-section__num">04 / Perceptual Chromatics</div>
            <h2 class="tv-section__title">Dual-Scope OKLCH Matrix &amp; Contrast Ledger</h2>
            <p class="tv-section__desc">
              Click any swatch to copy its hex value. A palette that only publishes its passing pairs is a brochure—below are all 12 computed pairs, including the 2 restricted failures.
            </p>
          </div>

          <div class="tv-swatch-grid">
            {tokens.primitives.slice(0, 9).map((p) => {
              const isFail = p.name === 'citron'
              return (
                <div class="tv-swatch-card" data-copy-hex={p.value}>
                  <div class="tv-swatch-card__preview" style={`background-color: ${p.value};`}></div>
                  <div class="tv-swatch-card__info">
                    <span class="tv-swatch-card__name">--tv-{p.name}</span>
                    <div class="tv-swatch-card__codes">
                      <span>{p.value}</span>
                      <span>{p.oklch.replace('oklch(', '').replace(')', '')}</span>
                    </div>
                    <span class="tv-swatch-card__role">{p.role}</span>
                    <span class={`tv-swatch-card__badge ${isFail ? 'tv-badge--fail' : 'tv-badge--pass'}`}>
                      {isFail ? '2.1:1 · Graphic Chip Only' : 'Verified Primitive'}
                    </span>
                  </div>
                </div>
              )
            })}
          </div>

          <!-- Measured Contrast Table -->
          <div class="tv-table-wrap">
            <table class="tv-table">
              <thead>
                <tr>
                  <th>Foreground / Background Pair</th>
                  <th>Measured Ratio</th>
                  <th>Status</th>
                  <th>Assigned Semantic Job</th>
                </tr>
              </thead>
              <tbody>
                {tokens.contrast.map((c) => (
                  <tr>
                    <td style="font-family: var(--tv-font-mono); font-weight: 600;">
                      --tv-{c.fg} on --tv-{c.bg}
                    </td>
                    <td style="font-family: var(--tv-font-mono); font-variant-numeric: tabular-nums;">
                      {c.ratio.toFixed(1)} : 1
                    </td>
                    <td>
                      <span class={`tv-swatch-card__badge ${c.pass ? 'tv-badge--pass' : 'tv-badge--fail'}`} style="margin: 0;">
                        {c.pass ? `PASS · ${c.target}` : `FAIL · ${c.target}`}
                      </span>
                    </td>
                    <td style="color: var(--tv-ink-secondary);">{c.role}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ===================================================================
           05 / OPEN-FOUNDRY TYPOGRAPHY & VARIABLE SPECIMEN
           =================================================================== -->
      <section id="typography" class="tv-section">
        <div class="tv-wrap">
          <div class="tv-section__header">
            <div class="tv-section__num">05 / Typographic Hierarchy</div>
            <h2 class="tv-section__title">Fraunces, Plus Jakarta Sans &amp; JetBrains Mono</h2>
            <p class="tv-section__desc">
              Warm optical-sized serif display headlines paired with disciplined humanist UI copy and tabular cellar numerals.
            </p>
          </div>

          <div class="tv-type-playground">
            <div class="tv-type-controls">
              <div class="tv-range-wrap">
                <label for="weightRange">
                  <span>Display Weight</span>
                  <span id="weightVal">500</span>
                </label>
                <input id="weightRange" type="range" min="300" max="800" value="500" step="50" />
              </div>

              <div class="tv-range-wrap">
                <label for="trackingRange">
                  <span>Letter Tracking</span>
                  <span id="trackingVal">-0.03em</span>
                </label>
                <input id="trackingRange" type="range" min="-0.06" max="0.10" value="-0.03" step="0.01" />
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                <span style="font-family: var(--tv-font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--tv-ink-secondary);">Cellar Figure Alignment</span>
                <button id="toggleTabularBtn" class="tv-btn-pill active" type="button">tabular-nums: ON</button>
              </div>
            </div>

            <div>
              <div style="font-family: var(--tv-font-mono); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--tv-accent-primary); margin-bottom: 0.45rem;">
                Live Editable Specimen (Click to type):
              </div>
              <div
                id="typeStage"
                class="tv-editable-stage"
                contenteditable="true"
                spellcheck="false"
                style="font-family: var(--tv-font-display); font-size: clamp(2rem, 3.8vw, 3.35rem); line-height: 1.04; letter-spacing: -0.03em; font-weight: 500;"
              >
                Spigola alla Griglia · Table 14 at 14:30 · €44.00
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 1rem; border-top: 1px solid var(--tv-border-subtle); padding-top: 1.5rem;">
              {tokens.type.scale.map((s) => (
                <div style="display: grid; grid-template-columns: 150px 1fr; align-items: baseline; gap: 1rem; padding-bottom: 0.85rem; border-bottom: 1px dashed var(--tv-border-subtle);">
                  <div style="font-family: var(--tv-font-mono); font-size: 0.72rem; color: var(--tv-ink-secondary);">
                    <strong style="color: var(--tv-ink-primary); display: block;">{s.role}</strong>
                    <span>{s.lh} / {s.ls}</span>
                  </div>
                  <div style={`font-family: ${s.role.includes('Micro') ? 'var(--tv-font-mono)' : s.role.includes('Body') || s.role.includes('Lead') || s.role.includes('Small') ? 'var(--tv-font-sans)' : 'var(--tv-font-display)'}; font-size: ${s.clamp.split(' ')[0]}; line-height: ${s.lh}; letter-spacing: ${s.ls}; font-weight: ${s.weight};`}>
                    {s.sample}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ===================================================================
           06 / INTERACTIVE REFRACTION & PHYSICS OVER COASTAL DISH BACKDROP
           =================================================================== -->
      <section id="physics" class="tv-section">
        <div class="tv-wrap">
          <div class="tv-section__header">
            <div class="tv-section__num">06 / Surface Physics &amp; Refraction</div>
            <h2 class="tv-section__title">Linen &amp; Sea-Glass Plate over Afternoon Light</h2>
            <p class="tv-section__desc">
              Test how the reading plate holds legibility over the freshly served sea bass photography (`tavola-dish.webp`) by scrubbing blur and linen opacity in real time.
            </p>
          </div>

          <div class="tv-type-controls" style="margin-bottom: 1.5rem; background: var(--tv-bg-surface); padding: 1.5rem; border-radius: var(--tv-radius-md); border: 1px solid var(--tv-border-subtle);">
            <div class="tv-range-wrap">
              <label for="blurRange">
                <span>Backdrop Blur (--tv-glass-blur)</span>
                <span id="blurVal">18px</span>
              </label>
              <input id="blurRange" type="range" min="0" max="32" value="18" step="1" />
            </div>
            <div class="tv-range-wrap">
              <label for="tintRange">
                <span>Linen Plate Opacity (--tv-plate-tint)</span>
                <span id="tintVal">86%</span>
              </label>
              <input id="tintRange" type="range" min="45" max="98" value="86" step="1" />
            </div>
            <div style="display: flex; align-items: flex-end;">
              <button id="triggerMotionBtn" class="tv-btn-pill active" style="width: 100%; padding: 0.65rem;" type="button">
                Replay Coastal Spring (320ms)
              </button>
            </div>
          </div>

          <div class="tv-refraction-stage">
            <img
              class="tv-refraction-stage__img"
              src={`${B}/tavola-dish.webp`}
              alt="Whole grilled Mediterranean sea bass with charred lemon and arugula on an ivory linen table."
              loading="lazy"
            />
            <div id="refractionPane" class="tv-refraction-stage__pane" style="transition: transform 360ms var(--tv-ease-coastal);">
              <span style="font-family: var(--tv-font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tv-accent-primary);">
                Second Course · Catch of the Day
              </span>
              <h3 style="font-family: var(--tv-font-display); font-size: 1.85rem; margin: 0.35rem 0 0.65rem; font-weight: 500;">
                Spigola alla Griglia con Limone d’Amalfi
              </h3>
              <p style="font-size: 0.95rem; color: var(--tv-ink-secondary); margin: 0 0 1rem;">
                Line-caught Mediterranean sea bass roasted with caperberry emulsion, wild rocket, blistered Datterini tomatoes, and charred lemon.
              </p>
