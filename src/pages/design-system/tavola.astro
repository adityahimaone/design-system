            </div>

            <div class="tv-booking-card">
              <div>
                <span style="font-family: var(--tv-font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--tv-accent-primary);">Table Ledger</span>
                <h3 style="font-family: var(--tv-font-display); font-size: 1.45rem; margin: 0.2rem 0 0.4rem 0;">Reserve an Afternoon Table</h3>
                <p style="font-size: 0.875rem; color: var(--tv-ink-secondary); margin: 0;">Choose your seating zone and sunlight hour.</p>
              </div>

              <div>
                <span style="display: block; font-family: var(--tv-font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--tv-ink-secondary); margin-bottom: 0.5rem;">
                  Seating Atmosphere
                </span>
                <div class="tv-table-selector">
                  <button class="tv-table-btn active table-loc-btn" data-loc="Covered Terrace (Sea View)" type="button">
                    <strong style="display: block; font-size: 0.875rem;">Covered Terrace</strong>
                    <span style="font-size: 0.75rem; color: var(--tv-ink-secondary);">Table 14 · Sea Horizon</span>
                  </button>
                  <button class="tv-table-btn table-loc-btn" data-loc="Vaulted Dining Room" type="button">
                    <strong style="display: block; font-size: 0.875rem;">Dining Room</strong>
                    <span style="font-size: 0.75rem; color: var(--tv-ink-secondary);">Table 06 · Cellar Wall</span>
                  </button>
                </div>
