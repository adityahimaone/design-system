              <div>
                <span style="display: block; font-family: var(--tv-font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--tv-ink-secondary); margin-bottom: 0.5rem;">
                  Afternoon Seating Hour
                </span>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  <button class="tv-btn-pill slot-btn" type="button">12:30</button>
                  <button class="tv-btn-pill active slot-btn" type="button">14:30</button>
                  <button class="tv-btn-pill slot-btn" type="button">16:00</button>
                  <button class="tv-btn-pill slot-btn" type="button">17:30 Sunset</button>
                </div>
              </div>

              <div id="bookingSummary" style="padding: 0.95rem; border-radius: var(--tv-radius-sm); background-color: var(--tv-bg-surface); font-family: var(--tv-font-mono); font-size: 0.78rem; border: 1px solid var(--tv-border-subtle);">
                Covered Terrace (Sea View) · 14:30 · Est. €66.00
              </div>

              <button id="bookTableBtn" class="tv-btn-primary" type="button">
                Confirm Terrace Reservation
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================================================================
           08 / THREE-LAYER TOKENS & HONEST AUDIT LEDGER
           =================================================================== -->
      <section id="tokens" class="tv-section" style="border-bottom: none;">
        <div class="tv-wrap">
          <div class="tv-section__header">
            <div class="tv-section__num">08 / One Source, Three Layers</div>
            <h2 class="tv-section__title">Copyable Token Architecture &amp; Audit</h2>
            <p class="tv-section__desc">
              The primitive layer never flips under the night scope—only the semantic bindings shift.
            </p>
          </div>

          <div class="tv-code-grid">
            {[
              { title: 'tavola-tokens.css · 1 · Primitives', code: cssPrimitives },
              { title: 'tavola-tokens.css · 2 · Daylight Scope', code: cssDay },
              { title: 'tavola-tokens.css · 2 · Evening Cellar Scope', code: cssNight },
              { title: 'tavola-tokens.css · 3 · Linen Reading Plate', code: cssPlate },
            ].map((item) => (
              <div class="tv-code-card">
                <header>
                  <span>{item.title}</span>
                  <button class="tv-btn-pill copy-code-btn" type="button" style="padding: 0.2rem 0.65rem;">Copy</button>
                </header>
                <pre><code>{item.code}</code></pre>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <!-- =====================================================================
         CLOSING FROZEN SPECIMEN — the spec readout held at its final state
         ===================================================================== -->
    <footer class="tv-foot">
      {/* footer: F3 · frozen specimen — the plinth holds the actual table, not
          a diagram of it. The photograph is flush to the stage edge, square,
          and the readout sits beside it on the dark ground. The hero is left
          alone; only the closing state changes. */}
      <div class="tv-foot__stage">
        <figure class="tv-foot__plate">
          <img
            src={`${B}/tavola-dish.webp`}
            alt="The coastal catch, plated: sea bass with citrus, herbs and oil on a linen-covered table above the water."
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="tv-foot__plate-cap">Fig. 06 · the catch, plated 14:30</figcaption>
        </figure>

        <div class="tv-wrap tv-foot__stage-inner">
          <dl class="tv-foot__readout">
            <div class="tv-foot__cell">
              <dt>Surface Tactility</dt>
              <dd>Woven Linen &amp; Sea Glass</dd>
            </div>
            <div class="tv-foot__cell">
              <dt>Spatial Density</dt>
              <dd>Editorial Balanced · 64ch</dd>
            </div>
            <div class="tv-foot__cell">
              <dt>Corner Physics</dt>
              <dd>Concentric · 18 / 10px</dd>
            </div>
            <div class="tv-foot__cell">
              <dt>Mark Geometry</dt>
              <dd>Kuwayama 64-Unit Grid</dd>
            </div>
          </dl>
          <div class="tv-foot__stage-foot">
            <p class="tv-foot__fig">Fig. 07 · final state — 4 specs held, 14.8:1 reading contrast</p>
            <p class="tv-foot__still">Motion halted · 40.633°N 14.602°E · 14:30 hold</p>
          </div>
        </div>
      </div>

      <div class="tv-foot__colophon">
        <div class="tv-wrap tv-foot__colophon-inner">
          <div class="tv-foot__identity">
            <img src={`${B}/lockup.svg`} width="165" height="33" alt="Tavola Mare & Terrazza" />
            <p class="tv-foot__statement">The page ends at the table.</p>
          </div>
          <nav class="tv-foot__links" aria-label="Tavola case files">
            <a href={`${B}/tavola-brandkit.png`} download>Brand Board (PNG)</a>
            <a href={`${B}/tavola-figma.html`}>Figma HTML Sheet</a>
            <a href={`${B}/mark.svg`} download>Mark (SVG)</a>
            <a href={`${B}/tavola-tokens.css`} download>tavola-tokens.css</a>
            <a href={`${B}/DESIGN.md`} download>DESIGN.md</a>
          </nav>
        </div>
        <div class="tv-wrap tv-foot__prov">
          <span>Tavola Mare &amp; Terrazza · Amalfi Coast · 2026 · v4.2 Coastal Edition</span>
          <a class="tv-foot__back" href="/">All cases →</a>
        </div>
      </div>
    </footer>
  </div>

  <script is:inline>
    // 1. Theme Scope Switcher
    const themeBtn = document.getElementById('themeToggleBtn')
    const themeLabel = document.getElementById('themeToggleLabel')
    const tvRoot = document.querySelector('.tv')

    function syncTheme(isNight) {
      if (isNight) {
        tvRoot?.setAttribute('data-tv', 'night')
        themeBtn?.setAttribute('aria-pressed', 'true')
        if (themeLabel) themeLabel.textContent = 'Evening Cellar'
        localStorage.setItem('tv-theme', 'night')
      } else {
        tvRoot?.removeAttribute('data-tv')
        themeBtn?.setAttribute('aria-pressed', 'false')
        if (themeLabel) themeLabel.textContent = 'Daylight Terrace'
        localStorage.setItem('tv-theme', 'day')
      }
    }

    if (localStorage.getItem('tv-theme') === 'night') syncTheme(true)
    themeBtn?.addEventListener('click', () => {
      syncTheme(tvRoot?.getAttribute('data-tv') !== 'night')
    })

    // 2. Hero Backdrop Scene Switcher
    const heroImg = document.getElementById('heroImage')
    const toggleHeroBtn = document.getElementById('toggleHeroPhoto')
    let isTableBackdrop = true
    toggleHeroBtn?.addEventListener('click', () => {
      isTableBackdrop = !isTableBackdrop
      if (heroImg) {
        heroImg.src = isTableBackdrop
          ? '/brand/tavola/tavola-table.webp'
          : '/brand/tavola/tavola-dish.webp'
      }
    })

    // 3. Brandmark Studio
    const toggleGridBtn = document.getElementById('toggleGridBtn')
    const gridOverlay = document.getElementById('gridOverlay')
    let gridOn = false
    toggleGridBtn?.addEventListener('click', () => {
      gridOn = !gridOn
      if (gridOverlay) gridOverlay.style.display = gridOn ? 'block' : 'none'
      toggleGridBtn.classList.toggle('active', gridOn)
    })

    const studioMarkImg = document.getElementById('studioMarkImg')
    const toggleLockupBtn = document.getElementById('toggleLockupBtn')
    const toggleStackedBtn = document.getElementById('toggleStackedBtn')

    toggleLockupBtn?.addEventListener('click', () => {
      toggleStackedBtn?.classList.remove('active')
      toggleLockupBtn.classList.toggle('active')
      if (studioMarkImg) {
        studioMarkImg.src = toggleLockupBtn.classList.contains('active')
          ? '/brand/tavola/lockup.svg'
          : '/brand/tavola/mark.svg'
      }
    })

    toggleStackedBtn?.addEventListener('click', () => {
      toggleLockupBtn?.classList.remove('active')
      toggleStackedBtn.classList.toggle('active')
      if (studioMarkImg) {
        studioMarkImg.src = toggleStackedBtn.classList.contains('active')
          ? '/brand/tavola/lockup-stacked.svg'
          : '/brand/tavola/mark.svg'
      }
    })

    const stage = document.getElementById('studioStage')
    document.querySelectorAll('.stage-bg-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.stage-bg-btn').forEach((b) => b.classList.remove('active'))
        btn.classList.add('active')
        const bg = btn.getAttribute('data-bg')
        if (!stage) return
        if (bg === 'surface') stage.style.backgroundColor = 'var(--tv-bg-surface)'
        if (bg === 'ivory') stage.style.backgroundColor = 'var(--tv-ivory)'
        if (bg === 'espresso') stage.style.backgroundColor = 'var(--tv-espresso)'
        if (bg === 'terracotta') stage.style.backgroundColor = 'var(--tv-terracotta)'
      })
    })

    // Copy Raw SVG
    const copyBtn = document.getElementById('copySvgBtn')
    const toast = document.getElementById('copyToast')
    copyBtn?.addEventListener('click', () => {
      const svgCode = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64" fill="none" role="img"><g fill="#D85A38" fill-rule="evenodd"><path d="M14 28 C14 18.06 22.06 10 32 10 C41.94 10 50 18.06 50 28 H43 C43 21.925 38.075 17 32 17 C25.925 17 21 21.925 21 28 Z"/><path d="M8 31 H56 V37 H8 Z"/><path d="M28 41 H36 V48 H48 V54 H16 V48 H28 Z"/><path d="M21 48 L26 43 H38 L43 48 L39 50 L35 46 H29 L25 50 Z"/></g></svg>`
      navigator.clipboard.writeText(svgCode).then(() => {
        if (toast) {
          toast.style.display = 'block'
          setTimeout(() => (toast.style.display = 'none'), 2500)
        }
      })
    })

    // 4. Click Swatch to Copy Hex
    document.querySelectorAll('[data-copy-hex]').forEach((card) => {
      card.addEventListener('click', () => {
        const hex = card.getAttribute('data-copy-hex')
        if (!hex) return
        navigator.clipboard.writeText(hex)
        const nameEl = card.querySelector('.tv-swatch-card__name')
        if (nameEl) {
          const prev = nameEl.textContent
          nameEl.textContent = `Copied ${hex}!`
          setTimeout(() => (nameEl.textContent = prev), 1400)
        }
      })
    })

    // 5. Typography Playground
    const typeStage = document.getElementById('typeStage')
    const weightRange = document.getElementById('weightRange')
    const weightVal = document.getElementById('weightVal')
    const trackingRange = document.getElementById('trackingRange')
    const trackingVal = document.getElementById('trackingVal')

    weightRange?.addEventListener('input', (e) => {
      const val = e.target.value
      if (weightVal) weightVal.textContent = val
      if (typeStage) typeStage.style.fontWeight = val
    })

    trackingRange?.addEventListener('input', (e) => {
      const val = `${e.target.value}em`
      if (trackingVal) trackingVal.textContent = val
      if (typeStage) typeStage.style.letterSpacing = val
    })

    const toggleTabular = document.getElementById('toggleTabularBtn')
    let isTabular = true
    toggleTabular?.addEventListener('click', () => {
      isTabular = !isTabular
      if (typeStage) typeStage.style.fontVariantNumeric = isTabular ? 'tabular-nums' : 'normal'
      toggleTabular.textContent = `tabular-nums: ${isTabular ? 'ON' : 'OFF'}`
      toggleTabular.classList.toggle('active', isTabular)
    })

    // 6. Refraction Stage over Coastal Dish
    const refractionPane = document.getElementById('refractionPane')
    const blurRange = document.getElementById('blurRange')
    const blurVal = document.getElementById('blurVal')
    const tintRange = document.getElementById('tintRange')
    const tintVal = document.getElementById('tintVal')

    blurRange?.addEventListener('input', (e) => {
      const v = `${e.target.value}px`
      if (blurVal) blurVal.textContent = v
      refractionPane?.style.setProperty('--tv-demo-blur', v)
    })

    tintRange?.addEventListener('input', (e) => {
      const v = `${e.target.value}%`
      if (tintVal) tintVal.textContent = v
      refractionPane?.style.setProperty('--tv-demo-tint', v)
    })

    document.getElementById('triggerMotionBtn')?.addEventListener('click', () => {
      if (!refractionPane) return
      refractionPane.style.transform = 'translateY(-10px) scale(1.02)'
      setTimeout(() => (refractionPane.style.transform = 'none'), 340)
    })

    // 7. Interactive Menu & Reservation Workbench
    let selectedLoc = 'Covered Terrace (Sea View)'
    let selectedSlot = '14:30'
    let menuTotal = 66
    const bookingSummary = document.getElementById('bookingSummary')
    const menuTotalBadge = document.getElementById('menuTotalBadge')

    function syncWorkbench() {
      if (menuTotalBadge) menuTotalBadge.textContent = `Selected: €${menuTotal.toFixed(2)}`
      if (bookingSummary) {
        bookingSummary.textContent = `${selectedLoc} · ${selectedSlot} · Est. €${menuTotal.toFixed(2)}`
      }
    }

    document.querySelectorAll('.dish-check').forEach((chk) => {
      chk.addEventListener('change', () => {
        let sum = 0
        document.querySelectorAll('.dish-check').forEach((c) => {
          if (c.checked) sum += Number(c.getAttribute('data-price') || 0)
        })
        menuTotal = sum
        syncWorkbench()
      })
    })

    document.querySelectorAll('.table-loc-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.table-loc-btn').forEach((b) => b.classList.remove('active'))
        btn.classList.add('active')
        selectedLoc = btn.getAttribute('data-loc') || 'Covered Terrace'
        syncWorkbench()
      })
    })

    document.querySelectorAll('.slot-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.slot-btn').forEach((b) => b.classList.remove('active'))
        btn.classList.add('active')
        selectedSlot = btn.textContent.trim()
        syncWorkbench()
      })
    })

    const bookBtn = document.getElementById('bookTableBtn')
    bookBtn?.addEventListener('click', () => {
      bookBtn.textContent = '✓ Confirmed · Table Held in Afternoon Light'
      bookBtn.style.backgroundColor = 'var(--tv-accent-olive)'
      setTimeout(() => {
        bookBtn.textContent = 'Confirm Terrace Reservation'
        bookBtn.style.backgroundColor = 'var(--tv-accent-primary)'
      }, 3200)
    })

    // 8. Copy Code Blocks
    document.querySelectorAll('.copy-code-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pre = btn.closest('.tv-code-card')?.querySelector('pre')
        if (!pre) return
        navigator.clipboard.writeText(pre.innerText).then(() => {
          const old = btn.textContent
          btn.textContent = 'Copied!'
          setTimeout(() => (btn.textContent = old), 1400)
        })
      })
    })
  </script>
</Layout>
