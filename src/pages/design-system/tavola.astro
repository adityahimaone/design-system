              <div class="tv-menu-dish">
                <div>
                  <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer;">
                    <input type="checkbox" class="dish-check" data-price="18" style="accent-color: var(--tv-accent-primary); width: 16px; height: 16px;" />
                    <span class="tv-dish-name">Greco di Tufo Riserva (Calice)</span>
                  </label>
                  <p class="tv-dish-desc" style="padding-left: 1.6rem;">Mineral-forward volcanic white with citrus blossom and sea salt finish.</p>
                </div>
                <span class="tv-dish-price">€18.00</span>
