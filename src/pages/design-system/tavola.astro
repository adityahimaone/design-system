              <div class="tv-menu-dish">
                <div>
                  <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer;">
                    <input type="checkbox" class="dish-check" data-price="44" checked style="accent-color: var(--tv-accent-primary); width: 16px; height: 16px;" />
                    <span class="tv-dish-name">Spigola alla Griglia con Limone</span>
