---
import Layout from '@/layouts/Layout.astro'
import { DESIGN_CASES } from '@/data/cases'
import '@/features/gloaming/gloaming-tokens.css'

/* A directory of post-brand landing pages. Derived from the case registry, so
   a new landing page appears here as soon as its case declares landingHref. */
const landings = DESIGN_CASES.filter((c) => c.landingHref)

const title = 'Field landing pages — Kanon'
const description =
  'Production landing pages built from the approved brand kits. Each one reuses the case\'s tokens, marks and measured plates rather than a second palette.'
---

<Layout title={title} description={description} canonical="/landing-page/" image="/brand/gloaming/gloaming-brandkit.png">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gloock&family=Hanken+Grotesk:wght@300..700&family=Martian+Mono:wght@300..700&display=swap" rel="stylesheet" />

  <div class="lp-root gl-scope" data-gl-scope="day">
    <div class="lp-shell">
      <header class="lp-head">
        <a class="lp-brand" href="/">Kanon</a>
        <nav class="lp-nav" aria-label="Primary">
          <a href="/">All cases</a>
          <a href="/api/cases.json">Case API</a>
        </nav>
      </header>

      <main>
        <section class="lp-intro">
          <h1>Landing pages, built from the kit.</h1>
          <p>
            A brand kit is only useful if it survives contact with a real page. These routes reuse
            the approved tokens, marks and measured plates — no second palette, no raw hex, no
            invented primitive.
          </p>
        </section>

        <ul class="lp-list">
          {landings.map((c) => (
            <li class="lp-card">
              <a class="lp-card__cover" href={c.landingHref!} aria-label={`Open the ${c.name} field landing page`}>
                <img src={`/brand/thumbs/${c.slug}.webp`} alt={c.coverAlt} width="1200" height="900" loading="lazy" />
              </a>
              <div class="lp-card__body">
                <div class="lp-card__meta">Case {c.number} · {c.tags[0]}</div>
                <h2><a href={c.landingHref!}>{c.name}</a></h2>
                <p class="lp-card__tag">{c.tagline}</p>
                <p class="lp-card__desc">{c.material}</p>
                <div class="lp-card__acts">
                  <a class="lp-btn" href={c.landingHref!}>Open the landing page</a>
                  <a class="lp-link" href={c.href}>Design system →</a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </main>

      <footer class="lp-foot">
        <span>{landings.length} field landing {landings.length === 1 ? 'page' : 'pages'} · Kanon · 2026</span>
        <a href="/">Back to all cases ↑</a>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .lp-root {
    min-height: 100svh;
    background: var(--gl-field-day) fixed;
    color: var(--gl-text-on-glass);
    font-family: var(--gl-font-reading);
    -webkit-font-smoothing: antialiased;
  }
  .lp-root * { box-sizing: border-box; }
  .lp-root a { color: inherit; }
  .lp-root img { display: block; max-width: 100%; }
  .lp-root :focus-visible { outline: 2px solid var(--gl-oat); outline-offset: 3px; }
  .lp-shell { width: 100%; max-width: calc(var(--gl-wrap) + 2 * var(--gl-gutter)); margin-inline: auto; padding-inline: var(--gl-gutter); }
  .lp-head { display: flex; align-items: center; gap: 28px; min-height: 70px; border-bottom: 1px solid var(--gl-line-strong); }
  .lp-brand { font-family: var(--gl-font-display); font-size: 25px; text-decoration: none; }
  .lp-nav { display: flex; gap: 22px; margin-left: auto; font-size: 13px; }
  .lp-nav a { text-decoration: none; opacity: .84; border-bottom: 1px solid transparent; padding-bottom: 3px; }
  .lp-nav a:hover { opacity: 1; border-bottom-color: currentColor; }
  .lp-intro { padding-block: clamp(56px, 8vw, 104px) clamp(36px, 5vw, 64px); }
  .lp-intro h1 { font-family: var(--gl-font-display); font-weight: 400; font-size: clamp(36px, 5.2vw, 72px); line-height: 1.06; letter-spacing: -.032em; margin: 0; max-width: 18ch; }
  .lp-intro p { margin: 22px 0 0; max-width: 56ch; font-size: clamp(15px, 1.2vw, 17px); line-height: 1.65; opacity: .9; }
  .lp-list { list-style: none; padding: 0; margin: 0 0 clamp(56px, 8vw, 104px); display: grid; gap: 20px; }
  .lp-card {
    display: grid; grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    background: var(--gl-surface-plate); color: var(--gl-text-primary);
    border-radius: var(--gl-radius-pane); overflow: hidden;
  }
  .lp-card__cover { display: block; position: relative; overflow: hidden; }
  .lp-card__cover img { width: 100%; height: 100%; min-height: 280px; object-fit: cover; }
  .lp-card__body { padding: clamp(24px, 3vw, 42px); }
  .lp-card :focus-visible { outline-color: var(--gl-ink); }
  .lp-card__meta { font-family: var(--gl-font-mono); font-variant-numeric: tabular-nums; font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; opacity: .68; }
  .lp-card h2 { font-family: var(--gl-font-display); font-weight: 400; font-size: clamp(30px, 3.4vw, 48px); margin: 14px 0 0; line-height: 1.08; }
  .lp-card h2 a { text-decoration: none; }
  .lp-card h2 a:hover { text-decoration: underline; }
  .lp-card__tag { margin: 10px 0 0; font-size: 16px; font-weight: 600; }
  .lp-card__desc { margin: 12px 0 0; font-size: 13.5px; line-height: 1.6; opacity: .78; max-width: 52ch; }
  .lp-card__acts { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 28px; }
  .lp-btn {
    display: inline-flex; align-items: center; min-height: 44px; padding: 11px 20px;
    background: var(--gl-btn-bg); color: var(--gl-btn-text);
    border-radius: var(--gl-radius-control); font-size: 14px; font-weight: 600; text-decoration: none;
    transition: transform 140ms cubic-bezier(.22, 1, .36, 1), background-color 180ms var(--gl-ease);
  }
  .lp-btn:active { transform: scale(.97); }
  .lp-link { font-size: 14px; font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--gl-ink); padding-bottom: 3px; opacity: .8; }
  .lp-link:hover { opacity: 1; }
  .lp-foot { display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; padding-block: 22px 36px; border-top: 1px solid var(--gl-line-strong); font-size: 11.5px; opacity: .82; }
  .lp-foot a { text-decoration: none; border-bottom: 1px solid var(--gl-line-strong); padding-bottom: 2px; }
  @media (max-width: 720px) {
    .lp-card { grid-template-columns: 1fr; }
    .lp-card__cover img { min-height: 200px; max-height: 260px; }
    .lp-nav { gap: 14px; font-size: 12px; }
  }
</style>
