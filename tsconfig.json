{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "next": ["./src/shims/next.ts"],
      "next/server": ["./src/shims/next-server.ts"],
      "next/image": ["./src/shims/next-image.tsx"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next-themes": ["./src/shims/next-themes.tsx"],
      "next/font/local": ["./src/shims/next-font-local.ts"],
      "next/font/google": ["./src/shims/next-font-google.ts"]
    }
  }
}
